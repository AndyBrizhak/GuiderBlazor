@page "/"
@rendermode InteractiveAuto

<PageTitle>Guider - Каталог бизнесов</PageTitle>

<div class="home-container">
    <div class="hero-section">
        <h1>Guider</h1>
        <p>Каталог локальных бизнесов и услуг</p>
    </div>

    <PlacesList />
</div>

<style>
