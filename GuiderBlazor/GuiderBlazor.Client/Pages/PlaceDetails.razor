@page "/place/{id}"
@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Client.Services
@inject IPlacesService PlacesService
@inject NavigationManager Navigation
@* @rendermode InteractiveAuto *@

<PageTitle>@(place?.Name ?? "Loading...")</PageTitle>

<div class="place-details-container">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading information...</p>
        </div>
    }
    else if (place != null)
    {
        <div class="details-header">
            @* <button class="btn-back" @onclick="GoBack">← Back to list</button> *@
            <a href="/" class="btn-back">← Back to list</a>
            <h1>@place.Name</h1>
            <span class="category-badge">@place.Category</span>
        </div>

        @if (place.ImgLink?.Any() == true)
        {
            <div class="image-gallery">
                @if (place.ImgLink.Count == 1)
                {
                    <img src="@place.ImgLink[0]" alt="@place.Name" class="single-image" />
                }
                else
                {
                    <div class="gallery-grid">
                        @foreach (var img in place.ImgLink.Take(6))
                        {
                            <img src="@img" alt="@place.Name" />
                        }
                    </div>
                }
            </div>
        }

        <div class="details-content">
            <div class="info-section">
                <h2>Description</h2>
                <div class="description">
                    @((MarkupString)place.Description)
                </div>
            </div>

            @if (place.Tags?.Any() == true)
            {
                <div class="info-section">
                    <h2>Tags</h2>
                    <div class="tags-container">
                        @foreach (var tag in place.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </div>
            }

            <div class="info-section">
                <h2>Contact Information</h2>

                @if (place.Address != null)
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <div>
                            <strong>Address:</strong><br />
                            @if (!string.IsNullOrEmpty(place.Address.Street) && place.Address.Street != "-")
                            {
                                <span>@place.Address.Street<br /></span>
                            }
                            @place.Address.City, @place.Address.Province<br />
                            @place.Address.Country
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(place.Phone?.Callable))
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <div>
                            <strong>Phone:</strong><br />
                            <a href="tel:+@place.Phone.Callable">+@place.Phone.Callable</a>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(place.Phone?.Whatsapp))
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <div>
                            <strong>WhatsApp:</strong><br />
                            <a href="https://wa.me/@place.Phone.Whatsapp" target="_blank">@place.Phone.Whatsapp</a>
                        </div>
                    </div>
                }
            </div>

            @if (place.Owner?.Any() == true)
            {
                @foreach (var owner in place.Owner)
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        <div>
                            <strong>Owner: @owner.Name</strong><br />
                            @if (!string.IsNullOrEmpty(owner.Phone))
                            {
                                <a href="tel:+@owner.Phone">+@owner.Phone</a>
                            }
                        </div>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(place.SocialNetwork?.Facebook) || !string.IsNullOrEmpty(place.SocialNetwork?.Instagram))
            {
                <div class="info-section">
                    <h2>Social Networks</h2>
                    <div class="social-links">
                        @if (!string.IsNullOrEmpty(place.SocialNetwork.Facebook))
                        {
                            <a href="@place.SocialNetwork.Facebook" target="_blank" class="social-link facebook">
                                Facebook
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(place.SocialNetwork.Instagram))
                        {
                            <a href="@place.SocialNetwork.Instagram" target="_blank" class="social-link instagram">
                                Instagram
                            </a>
                        }
                    </div>
                </div>
            }

            @if (place.Location?.Coordinates?.Count == 2)
            {
                <div class="info-section">
                    <h2>Location on map</h2>
                    <div class="map-placeholder">
                        <p>Coordinates: @place.Location.Coordinates[1], @place.Location.Coordinates[0]</p>
                        <a href="https://www.google.com/maps?q=@place.Location.Coordinates[1],@place.Location.Coordinates[0]"
                           target="_blank"
                           class="btn-map">
                            Open in Google Maps
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="error-message">
            <h2>Place not found</h2>
            <p>Unfortunately, information about this place is not available.</p>
            <button class="btn-back" @onclick="GoBack">← Back to list</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Place? place;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlace();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            await LoadPlace();
        }
    }

    private async Task LoadPlace()
    {
        isLoading = true;
        place = await PlacesService.GetPlaceByIdAsync(Id);
        isLoading = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}


