@page "/place/{id}"
@using GuiderBlazor.Client.Models
@using GuiderBlazor.Client.Services
@inject IPlacesService PlacesService
@inject NavigationManager Navigation
@rendermode InteractiveAuto

<PageTitle>@(place?.Name ?? "Загрузка...")</PageTitle>

<div class="place-details-container">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Загрузка информации...</p>
        </div>
    }
    else if (place != null)
    {
        <div class="details-header">
            <button class="btn-back" @onclick="GoBack">← Назад к списку</button>
            <h1>@place.Name</h1>
            <span class="category-badge">@place.Category</span>
        </div>

        @if (place.ImgLink?.Any() == true)
        {
            <div class="image-gallery">
                @if (place.ImgLink.Count == 1)
                {
                    <img src="@place.ImgLink[0]" alt="@place.Name" class="single-image" />
                }
                else
                {
                    <div class="gallery-grid">
                        @foreach (var img in place.ImgLink.Take(6))
                        {
                            <img src="@img" alt="@place.Name" />
                        }
                    </div>
                }
            </div>
        }

        <div class="details-content">
            <div class="info-section">
                <h2>Описание</h2>
                <div class="description">
                    @((MarkupString)place.Description)
                </div>
            </div>

            @if (place.Tags?.Any() == true)
            {
                <div class="info-section">
                    <h2>Теги</h2>
                    <div class="tags-container">
                        @foreach (var tag in place.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </div>
            }

            <div class="info-section">
                <h2>Контактная информация</h2>

                @if (place.Address != null)
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <div>
                            <strong>Адрес:</strong><br />
                            @if (!string.IsNullOrEmpty(place.Address.Street) && place.Address.Street != "-")
                            {
                                <span>@place.Address.Street<br /></span>
                            }
                            @place.Address.City, @place.Address.Province<br />
                            @place.Address.Country
                        </div>
                    </div>
                }

                @if (place.Phone?.Callable > 0)
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <div>
                            <strong>Телефон:</strong><br />
                            <a href="tel:+@place.Phone.Callable">+@place.Phone.Callable</a>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(place.Phone?.Whatsapp))
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <div>
                            <strong>WhatsApp:</strong><br />
                            <a href="https://wa.me/@place.Phone.Whatsapp" target="_blank">@place.Phone.Whatsapp</a>
                        </div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(place.SocialNetwork?.Facebook) || !string.IsNullOrEmpty(place.SocialNetwork?.Instagram))
            {
                <div class="info-section">
                    <h2>Социальные сети</h2>
                    <div class="social-links">
                        @if (!string.IsNullOrEmpty(place.SocialNetwork.Facebook))
                        {
                            <a href="@place.SocialNetwork.Facebook" target="_blank" class="social-link facebook">
                                Facebook
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(place.SocialNetwork.Instagram))
                        {
                            <a href="@place.SocialNetwork.Instagram" target="_blank" class="social-link instagram">
                                Instagram
                            </a>
                        }
                    </div>
                </div>
            }

            @if (place.Location?.Coordinates?.Count == 2)
            {
                <div class="info-section">
                    <h2>Расположение на карте</h2>
                    <div class="map-placeholder">
                        <p>Координаты: @place.Location.Coordinates[1], @place.Location.Coordinates[0]</p>
                        <a href="https://www.google.com/maps?q=@place.Location.Coordinates[1],@place.Location.Coordinates[0]"
                           target="_blank"
                           class="btn-map">
                            Открыть в Google Maps
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="error-message">
            <h2>Место не найдено</h2>
            <p>К сожалению, информация о данном месте недоступна.</p>
            <button class="btn-back" @onclick="GoBack">← Вернуться к списку</button>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Place? place;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlace();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Id))
        {
            await LoadPlace();
        }
    }

    private async Task LoadPlace()
    {
        isLoading = true;
        place = await PlacesService.GetPlaceByIdAsync(Id);
        isLoading = false;
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/");
    }
}

<style>
    .place-details-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .loading, .error-message {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 2rem;
        text-align: center;
    }

    .spinner {
        border: 4px solid #f3f3f3;
        border-top: 4px solid #007bff;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

    .details-header {
        margin-bottom: 2rem;
    }

    .btn-back {
        background: #f8f9fa;
        border: 1px solid #ddd;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        cursor: pointer;
        margin-bottom: 1rem;
        display: inline-block;
        transition: background 0.3s;
    }

        .btn-back:hover {
            background: #e9ecef;
        }

    .details-header h1 {
        margin: 0.5rem 0;
        color: #333;
    }

    .category-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #e3f2fd;
        color: #1976d2;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 500;
        text-transform: capitalize;
    }

    .image-gallery {
        margin-bottom: 2rem;
        border-radius: 8px;
        overflow: hidden;
    }

    .single-image {
        width: 100%;
        max-height: 500px;
        object-fit: cover;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 0.5rem;
    }

        .gallery-grid img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

    .details-content {
        background: white;
        border-radius: 8px;
        padding: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .info-section {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid #e9ecef;
    }

        .info-section:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .info-section h2 {
            color: #333;
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }

    .description {
        color: #555;
        line-height: 1.6;
    }

    .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .tag {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: #f5f5f5;
        color: #666;
        border-radius: 4px;
        font-size: 0.9rem;
    }

    .info-item {
        display: flex;
        gap: 1rem;
        margin-bottom: 1.5rem;
        align-items: start;
    }

        .info-item svg {
            flex-shrink: 0;
            color: #007bff;
            margin-top: 0.25rem;
        }

        .info-item a {
            color: #007bff;
            text-decoration: none;
        }

            .info-item a:hover {
                text-decoration: underline;
            }

    .social-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .social-link {
        padding: 0.5rem 1.5rem;
        border-radius: 4px;
        text-decoration: none;
        color: white;
        font-weight: 500;
        transition: opacity 0.3s;
    }

        .social-link:hover {
            opacity: 0.9;
        }

        .social-link.facebook {
            background: #1877f2;
        }

        .social-link.instagram {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        }

    .map-placeholder {
        background: #f8f9fa;
        padding: 2rem;
        border-radius: 8px;
        text-align: center;
    }

    .btn-map {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.75rem 1.5rem;
        background: #007bff;
        color: white;
        text-decoration: none;
        border-radius: 4px;
        transition: background 0.3s;
    }

        .btn-map:hover {
            background: #0056b3;
        }

    @media (max-width: 768px) {
        .gallery-grid

    {
        grid-template-columns: 1fr;
    }

    }
</style>
