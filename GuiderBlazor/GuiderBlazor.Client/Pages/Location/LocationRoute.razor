@page "/location/{*slugs}"
@inject NavigationManager Navigation

@* 1. ДОБАВЬТЕ ЭТО:
   Делаем компонент интерактивным,
   чтобы NavigationManager работал на клиенте.
*@
@rendermode InteractiveServer

@code {
    [Parameter]
    public string Slugs { get; set; } = string.Empty;

    // 2. Логика ПЕРЕМЕЩЕНА из OnInitialized()
    protected override void OnAfterRender(bool firstRender)
    {
        // Мы запускаем редирект ТОЛЬКО
        // при первой отрисовке компонента
        if (firstRender)
        {
            // 1. Разбиваем URL (например, "guanacaste/sardinal")
            var parts = Slugs.Split(new[] { '/' }, StringSplitOptions.RemoveEmptyEntries);

            // 2. Берем слаги как есть, в нижнем регистре.
            string? provinceSlug = parts.Length > 0 ? parts[0].ToLower() : null;
            string? citySlug = parts.Length > 1 ? parts[1].ToLower() : null;

            // 3. Собираем query-параметры
            var queryParams = new Dictionary<string, object?>();

            if (!string.IsNullOrEmpty(provinceSlug))
            {
                // API ждет "province=guanacaste"
                queryParams["Province"] = provinceSlug;
            }
            if (!string.IsNullOrEmpty(citySlug))
            {
                // API ждет "city=sardinal"
                queryParams["City"] = citySlug;
            }

            // 4. Перенаправляем на главную страницу (/)
            var url = Navigation.GetUriWithQueryParameters("/", queryParams);

            // 5. replace: true - это важно.
            // Он заменяет /location/guanacaste на /?Province=guanacaste
            // в истории браузера.
            Navigation.NavigateTo(url, replace: true);
        }
    }
}
