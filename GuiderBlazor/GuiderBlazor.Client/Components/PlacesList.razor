@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services
@inject IPlacesService PlacesService
@inject NavigationManager Navigation // 1. Подключаем NavigationManager


<div class="places-list-container">

    @* Шаг 1 (ВЫ СДЕЛАЛИ): Мы передаем 'currentFilters' ВНУТРЬ компонента PlacesFilter,
      чтобы он мог отобразить текущее состояние из URL.
    *@
    <PlacesFilter CurrentFilters="currentFilters"
                  OnFilterChanged="HandleFilterChanged" />

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading places...</p>
        </div>
    }
    else if (placesResponse?.Places?.Any() == true)
    {
        <div class="places-grid">
            @foreach (var place in placesResponse.Places)
            {
                <PlaceCard Place="place" />
            }
        </div>

        <div class="pagination">
            <div class="pagination-info">
                Showing @placesResponse.Places.Count of @placesResponse.TotalCount results
                (Page @placesResponse.Page of @placesResponse.TotalPages)
            </div>

            <div class="pagination-controls">
                @* 7. ИЗМЕНЕНО: Пагинация теперь вызывает 'ChangePage' *@
                <button class="btn-page"
                        @onclick="() => ChangePage(1)"
                        disabled="@(currentFilters.Page == 1)">
                    First
                </button>

                <button class="btn-page"
                        @onclick="() => ChangePage(currentFilters.Page - 1)"
                        disabled="@(currentFilters.Page == 1)">
                    ← Previous
                </button>

                <button class="btn-page"
                        @onclick="() => ChangePage(currentFilters.Page + 1)"
                        disabled="@(currentFilters.Page >= placesResponse.TotalPages)">
                    Next →
                </button>

                <button class="btn-page"
                        @onclick="() => ChangePage(placesResponse.TotalPages)"
                        disabled="@(currentFilters.Page >= placesResponse.TotalPages)">
                    Last
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="no-results">
            <h2>No places found</h2>
            <p>Try adjusting your filters or search query.</p>
        </div>
    }
</div>

@code {
    // 2. Определяем параметры, которые компонент будет читать из URL
    [SupplyParameterFromQuery]
    public string? Q { get; set; }

    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    [SupplyParameterFromQuery]
    public string? Province { get; set; }

    [SupplyParameterFromQuery]
    public string? City { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    // Устанавливаем 4 по умолчанию, как в вашем коде
    [SupplyParameterFromQuery]
    public int PerPage { get; set; } = 4;

    private PlacesResponse? placesResponse;
    private PlaceFilterParams currentFilters = new(); // Этот объект будет "состоянием"
    private bool isLoading = true;


    // 3. ИЗМЕНЕНО: OnParametersSetAsync ВМЕСТО OnInitializedAsync
    // Этот метод будет вызываться КАЖДЫЙ РАЗ, когда параметры URL меняются
    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        // 4. Собираем 'currentFilters' из параметров URL
        currentFilters = new PlaceFilterParams
        {
            Q = this.Q,
            Category = this.Category,
            Province = this.Province,
            City = this.City,
            Page = this.Page,        // ← Если null, используем 1
            PerPage = this.PerPage   // ← Если null, используем 4
        };

        
        // Принудительно устанавливаем значения по умолчанию,
        // если они не заданы (т.е. равны 0)
        if (currentFilters.Page <= 0)
        {
            currentFilters.Page = 1;
        }
        if (currentFilters.PerPage <= 0)
        {
            currentFilters.PerPage = 4; // значение по умолчанию
        }
        

        // 5. Загружаем данные на основе фильтров из URL
        placesResponse = await PlacesService.GetPlacesAsync(currentFilters);
        isLoading = false;

        // StateHasChanged() не нужен, т.к. OnParametersSetAsync сам вызывает перерисовку.
    }

    // 6. ИЗМЕНЕНО: HandleFilterChanged ТЕПЕРЬ МЕНЯЕТ URL
    private void HandleFilterChanged(PlaceFilterParams newFilters)
    {
        // Мы не вызываем LoadPlaces(). Мы меняем URL.
        // Смена URL вызовет OnParametersSetAsync, который загрузит данные.
        Navigation.NavigateTo(GetQueryString(newFilters));
    }

    // 7. ИЗМЕНЕНО: Пагинация ТЕПЕРЬ МЕНЯЕТ URL
    private void ChangePage(int newPage)
    {
        if (newPage < 1) newPage = 1;
        if (placesResponse != null && newPage > placesResponse.TotalPages)
        {
            newPage = placesResponse.TotalPages;
        }

        currentFilters.Page = newPage;
        Navigation.NavigateTo(GetQueryString(currentFilters));
    }

    // 8. Вспомогательный метод для построения URL (Query String)
    private string GetQueryString(PlaceFilterParams filters)
    {
        var queryParams = new Dictionary<string, object?>();

        // Добавляем только те параметры, которые имеют значение
        if (!string.IsNullOrEmpty(filters.Q))
            queryParams["Q"] = filters.Q;

        if (!string.IsNullOrEmpty(filters.Category))
            queryParams["Category"] = filters.Category;

        if (!string.IsNullOrEmpty(filters.Province))
            queryParams["Province"] = filters.Province;

        if (!string.IsNullOrEmpty(filters.City))
            queryParams["City"] = filters.City;

        if (filters.Page > 1)
            queryParams["Page"] = filters.Page;

        if (filters.PerPage != 4) // 4 - наше значение по умолчанию
            queryParams["PerPage"] = filters.PerPage;

        // (добавьте сюда Tags, Lat/Lon и т.д., если они тоже должны быть в URL)

        var queryString = string.Join("&", queryParams
            .Where(kvp => kvp.Value != null)
            .Select(kvp => $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value.ToString()!)}"));

        // Возвращаем / (главную) или /?Q=search...
        return string.IsNullOrEmpty(queryString) ? "/" : $"?{queryString}";
    }
}

