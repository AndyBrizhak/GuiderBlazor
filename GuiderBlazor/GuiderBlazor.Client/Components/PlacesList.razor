@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services

@inject NavigationManager Navigation

<div class="places-list-container">

    @* Передаем параметры вниз *@
    <PlacesFilter CurrentFilters="CurrentFilters" />

    @if (IsLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading places...</p>
        </div>
    }
    else if (PlacesResponse?.Places?.Any() == true)
    {
        <section aria-label="Search Results">
            <h2 class="visually-hidden">Found Places in Costa Rica</h2>

            <div class="sort-controls">
                @* ФОРМА СОРТИРОВКИ 
                   Используем data-enhance для "мягкой" навигации (Этап 2),
                   а пока это просто сработает как GET-запрос.
                *@
                <form method="get" action="/" data-enhance>
                    @* Сохраняем текущие фильтры в скрытых полях, чтобы они не слетели *@
                    @RenderHiddenInputs()

                    <div class="form-group">
                        <label>Sort by:</label>
                        @* onchange="this.form.submit()" автоматически отправит форму при выборе *@
                        <select name="SortField" class="form-control" onchange="this.form.submit()">
                            <option value="name" selected="@(CurrentFilters.SortField == "name" || string.IsNullOrEmpty(CurrentFilters.SortField))">Name</option>
                            <option value="category" selected="@(CurrentFilters.SortField == "category")">Category</option>
                            @if (CurrentFilters.Latitude.HasValue)
                            {
                                <option value="distance" selected="@(CurrentFilters.SortField == "distance")">Distance</option>
                            }
                        </select>
                    </div>
                </form>

                @* КНОПКА ПОРЯДКА СОРТИРОВКИ (Теперь это ссылка) *@
                <a class="btn-sort-order"
                   href="@GetUrlForSortOrder()"
                   data-enhance
                   title="Change Sort Order">
                    @if (CurrentFilters.SortOrder == "desc")
                    {
                        @* Если сейчас DESC, показываем иконку Z-A *@
                        <svg viewBox="0 0 24 24"><path d="M12 5v14m-6-6l6 6l6-6" /></svg>
                    }
                    else
                    {
                        @* Иначе показываем A-Z *@
                        <svg viewBox="0 0 24 24"><path d="M12 19V5m-6 6l6-6l6 6" /></svg>
                    }
                </a>
            </div>

            <div class="places-grid">
                @foreach (var place in PlacesResponse.Places)
                {
                    <PlaceCard Place="place" />
                }
            </div>

            <div class="pagination">
                <div class="pagination-controls">

                    @* Кнопка НАЗАД *@
                    <a class="btn-page @(CurrentFilters.Page <= 1 ? "disabled" : "")"
                       href="@GetUrlForPage(CurrentFilters.Page - 1)"
                       data-enhance
                       aria-label="Previous Page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                    </a>

                    @* PER PAGE (Тоже форма) *@
                    <div class="pagination-per-page">
                        <form method="get" action="/" data-enhance>
                            @RenderHiddenInputs()
                            <label>Per Page:</label>
                            <select name="PerPage" class="form-control" onchange="this.form.submit()">
                                <option value="4" selected="@(CurrentFilters.PerPage == 4)">4</option>
                                <option value="8" selected="@(CurrentFilters.PerPage == 8)">8</option>
                                <option value="12" selected="@(CurrentFilters.PerPage == 12)">12</option>
                                <option value="16" selected="@(CurrentFilters.PerPage == 16)">16</option>
                                <option value="20" selected="@(CurrentFilters.PerPage == 20)">20</option>
                            </select>
                        </form>
                    </div>

                    <div class="pagination-info">
                        @PlacesResponse.Page / @PlacesResponse.TotalPages
                    </div>

                    @* Кнопка ВПЕРЕД *@
                    <a class="btn-page @(CurrentFilters.Page >= PlacesResponse.TotalPages ? "disabled" : "")"
                       href="@GetUrlForPage(CurrentFilters.Page + 1)"
                       data-enhance
                       aria-label="Next Page">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
                    </a>

                </div>
            </div>

        </section>
    }
    else
    {
        <div class="no-results">
            <h2>No places found</h2>
            <p>Try adjusting your filters or search query.</p>
        </div>
    }
</div>

@code {
    [Parameter] public PlacesResponse? PlacesResponse { get; set; }
    [Parameter] public PlaceFilterParams CurrentFilters { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>
    /// Рендерит скрытые инпуты для сохранения текущего состояния фильтров
    /// внутри форм сортировки и пагинации
    /// </summary>
    private RenderFragment RenderHiddenInputs() => builder =>
    {
        if (!string.IsNullOrEmpty(CurrentFilters.Q))
        {
            builder.OpenElement(0, "input");
            builder.AddAttribute(1, "type", "hidden");
            builder.AddAttribute(2, "name", "Q");
            builder.AddAttribute(3, "value", CurrentFilters.Q);
            builder.CloseElement();
        }
        if (!string.IsNullOrEmpty(CurrentFilters.Category))
        {
            builder.OpenElement(4, "input");
            builder.AddAttribute(5, "type", "hidden");
            builder.AddAttribute(6, "name", "Category");
            builder.AddAttribute(7, "value", CurrentFilters.Category);
            builder.CloseElement();
        }
        if (!string.IsNullOrEmpty(CurrentFilters.Province))
        {
            builder.OpenElement(8, "input");
            builder.AddAttribute(9, "type", "hidden");
            builder.AddAttribute(10, "name", "Province");
            builder.AddAttribute(11, "value", CurrentFilters.Province);
            builder.CloseElement();
        }
        if (!string.IsNullOrEmpty(CurrentFilters.City))
        {
            builder.OpenElement(12, "input");
            builder.AddAttribute(13, "type", "hidden");
            builder.AddAttribute(14, "name", "City");
            builder.AddAttribute(15, "value", CurrentFilters.City);
            builder.CloseElement();
        }
        // Гео и другие параметры...
        if (CurrentFilters.Latitude.HasValue)
        {
            builder.OpenElement(16, "input");
            builder.AddAttribute(17, "type", "hidden");
            builder.AddAttribute(18, "name", "Latitude");
            builder.AddAttribute(19, "value", CurrentFilters.Latitude);
            builder.CloseElement();

            builder.OpenElement(20, "input");
            builder.AddAttribute(21, "type", "hidden");
            builder.AddAttribute(22, "name", "Longitude");
            builder.AddAttribute(23, "value", CurrentFilters.Longitude);
            builder.CloseElement();

            if (CurrentFilters.Distance.HasValue)
            {
                builder.OpenElement(24, "input");
                builder.AddAttribute(25, "type", "hidden");
                builder.AddAttribute(26, "name", "Distance");
                builder.AddAttribute(27, "value", CurrentFilters.Distance);
                builder.CloseElement();
            }
        }
        if (CurrentFilters.Tags != null)
        {
            foreach (var tag in CurrentFilters.Tags)
            {
                builder.OpenElement(28, "input");
                builder.AddAttribute(29, "type", "hidden");
                builder.AddAttribute(30, "name", "Tags");
                builder.AddAttribute(31, "value", tag);
                builder.CloseElement();
            }
        }
        // IsOpen
        if (CurrentFilters.IsOpen == true)
        {
            builder.OpenElement(32, "input");
            builder.AddAttribute(33, "type", "hidden");
            builder.AddAttribute(34, "name", "IsOpen");
            builder.AddAttribute(35, "value", "true");
            builder.CloseElement();
        }
    };

    // Генерирует URL для переключения порядка сортировки (ASC <-> DESC)
    private string GetUrlForSortOrder()
    {
        var newOrder = (CurrentFilters.SortOrder == "desc") ? "asc" : "desc";

        var linkFilters = CloneFilters(CurrentFilters);
        linkFilters.SortOrder = newOrder;

        // Сбрасываем страницу на 1 при смене сортировки
        linkFilters.Page = 1;

        return GetQueryString(linkFilters);
    }

    private string GetUrlForPage(int newPage)
    {
        if (newPage < 1) newPage = 1;
        if (PlacesResponse != null && newPage > PlacesResponse.TotalPages)
        {
            newPage = PlacesResponse.TotalPages;
        }

        var linkFilters = CloneFilters(CurrentFilters);
        linkFilters.Page = newPage;

        return GetQueryString(linkFilters);
    }

    // Хелпер для клонирования, чтобы не мутировать текущий стейт
    private PlaceFilterParams CloneFilters(PlaceFilterParams source)
    {
        return new PlaceFilterParams
        {
            Q = source.Q,
            Category = source.Category,
            Province = source.Province,
            City = source.City,
            PerPage = source.PerPage,
            Page = source.Page,
            Tags = source.Tags?.ToList(),
            Latitude = source.Latitude,
            Longitude = source.Longitude,
            Distance = source.Distance,
            SortField = source.SortField,
            SortOrder = source.SortOrder,
            IsOpen = source.IsOpen
        };
    }

    private string GetQueryString(PlaceFilterParams filters)
    {
        var queryParams = new Dictionary<string, object?>();

        if (!string.IsNullOrEmpty(filters.Q)) queryParams["Q"] = filters.Q;
        if (!string.IsNullOrEmpty(filters.Category)) queryParams["Category"] = filters.Category;
        if (!string.IsNullOrEmpty(filters.Province)) queryParams["Province"] = filters.Province;
        if (!string.IsNullOrEmpty(filters.City)) queryParams["City"] = filters.City;
        if (filters.Page > 1) queryParams["Page"] = filters.Page;
        if (filters.PerPage != 4) queryParams["PerPage"] = filters.PerPage;

        if (filters.Latitude.HasValue) queryParams["Latitude"] = filters.Latitude.Value;
        if (filters.Longitude.HasValue) queryParams["Longitude"] = filters.Longitude.Value;
        if (filters.Distance.HasValue) queryParams["Distance"] = filters.Distance.Value;

        if (filters.IsOpen == true) queryParams["IsOpen"] = "true";

        if (!string.IsNullOrEmpty(filters.SortField)) queryParams["SortField"] = filters.SortField;
        if (!string.IsNullOrEmpty(filters.SortOrder)) queryParams["SortOrder"] = filters.SortOrder;

        var queryParts = new List<string>();
        queryParts.AddRange(queryParams
            .Where(kvp => kvp.Value != null)
            .Select(kvp => $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value.ToString()!)}"));

        if (filters.Tags != null && filters.Tags.Any())
        {
            foreach (var tag in filters.Tags)
            {
                if (!string.IsNullOrEmpty(tag))
                {
                    queryParts.Add($"Tags={Uri.EscapeDataString(tag)}");
                }
            }
        }

        return queryParts.Count == 0 ? "/" : $"?{string.Join("&", queryParts)}";
    }
}