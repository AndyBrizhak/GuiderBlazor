@using GuiderBlazor.Client.Models
@using GuiderBlazor.Client.Services
@inject IPlacesService PlacesService
@rendermode InteractiveAuto

<div class="places-list-container">
    <PlacesFilter OnFilterChanged="HandleFilterChanged" />

    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Загрузка мест...</p>
        </div>
    }
    else if (placesResponse?.Data?.Any() == true)
    {
        <div class="places-grid">
            @foreach (var place in placesResponse.Data)
            {
                <PlaceCard Place="place" />
            }
        </div>

        <div class="pagination">
            <div class="pagination-info">
                Показано @placesResponse.Data.Count из @placesResponse.Total результатов
                (Страница @placesResponse.Page из @placesResponse.TotalPages)
            </div>

            <div class="pagination-controls">
                <button class="btn-page"
                        @onclick="FirstPage"
                        disabled="@(currentFilters.Page == 1)">
                    Первая
                </button>

                <button class="btn-page"
                        @onclick="PreviousPage"
                        disabled="@(currentFilters.Page == 1)">
                    ← Предыдущая
                </button>

                <span class="page-numbers">
                    @for (int i = Math.Max(1, currentFilters.Page - 2);
                                    i <= Math.Min(placesResponse.TotalPages, currentFilters.Page + 2);
                                    i++)
                    {
                        var pageNum = i;
                        <button class="btn-page-num @(pageNum == currentFilters.Page ? "active" : "")"
                                @onclick="() => GoToPage(pageNum)">
                            @pageNum
                        </button>
                    }
                </span>

                <button class="btn-page"
                        @onclick="NextPage"
                        disabled="@(currentFilters.Page >= placesResponse.TotalPages)">
                    Следующая →
                </button>

                <button class="btn-page"
                        @onclick="LastPage"
                        disabled="@(currentFilters.Page >= placesResponse.TotalPages)">
                    Последняя
                </button>
            </div>
        </div>
    }
    else if (!isLoading)
    {
        <div class="no-results">
            <h3>Результаты не найдены</h3>
            <p>Попробуйте изменить параметры фильтрации</p>
        </div>
    }
</div>

@code {
    private PlacesResponse? placesResponse;
    private PlaceFilterParams currentFilters = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlaces();
    }

    private async Task HandleFilterChanged(PlaceFilterParams filters)
    {
        currentFilters = filters;
        await LoadPlaces();
    }

    private async Task LoadPlaces()
    {
        isLoading = true;
        StateHasChanged();

        placesResponse = await PlacesService.GetPlacesAsync(currentFilters);

        isLoading = false;
        StateHasChanged();
    }

    private async Task FirstPage()
    {
        currentFilters.Page = 1;
        await LoadPlaces();
    }

    private async Task PreviousPage()
    {
        if (currentFilters.Page > 1)
        {
            currentFilters.Page--;
            await LoadPlaces();
        }
    }

    private async Task NextPage()
    {
        if (placesResponse != null && currentFilters.Page < placesResponse.TotalPages)
        {
            currentFilters.Page++;
            await LoadPlaces();
        }
    }

    private async Task LastPage()
    {
        if (placesResponse != null)
        {
            currentFilters.Page = placesResponse.TotalPages;
            await LoadPlaces();
        }
    }

    private async Task GoToPage(int pageNumber)
    {
        currentFilters.Page = pageNumber;
        await LoadPlaces();
    }
}


