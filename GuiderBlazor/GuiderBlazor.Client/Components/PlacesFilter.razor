@using GuiderBlazor.Shared.Models
@rendermode InteractiveServer

<div class="filter-container">
    <div class="filter-card">

        <div class="category-scroller">
            @* --- ⬇️ ВОТ ИЗМЕНЕНИЯ ⬇️ --- *@
            @* 1. <button> заменен на <a> *@
            @* 2. @onclick заменен на href *@
            <a class="category-btn @(filters.Category == "" ? "active" : "")"
               href="@GetUrlForCategory("")">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" /></svg>
                All
            </a>
            <a class="category-btn @(filters.Category == "services" ? "active" : "")"
               href="@GetUrlForCategory("services")">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M11.49 3.17a.75.75 0 01.02 1.06L8.52 7.25h3.98l-4 5.25a.75.75 0 01-1.02-1.06l2.99-3.94H6.02l4-5.25a.75.75 0 011.02-.06zM6.25 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H7a.75.75 0 01-.75-.75V12zM10 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H10.75a.75.75 0 01-.75-.75V12zM13.75 12a.75.75 0 01.75-.75h.01a.75.75 0 01.75.75v.01a.75.75 0 01-.75.75H14.5a.75.75 0 01-.75-.75V12z" clip-rule="evenodd" /></svg>
                Services
            </a>
            <a class="category-btn @(filters.Category == "to-eat" ? "active" : "")"
               href="@GetUrlForCategory("to-eat")">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M7.45 1.13 5.99 3.27 3.84 3.48a.75.75 0 00-.53 1.28l1.54 1.63-.33 2.26a.75.75 0 001.07.81l2.02-1.14 2.02 1.14a.75.75 0 001.07-.81l-.33-2.26 1.54-1.63a.75.75 0 00-.53-1.28l-2.15-.21L9.55 1.13a.75.75 0 00-1.02-.01l-.01 0zM10 12.25a.75.75 0 01.75.75v5.75a.75.75 0 01-1.5 0v-5.75a.75.75 0 01.75-.75z" /></svg>
                Foods
            </a>
            <a class="category-btn @(filters.Category == "adventures" ? "active" : "")"
               href="@GetUrlForCategory("adventures")">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M.91 8.23c.06-.2.24-.34.46-.38l4.07-.59 1.82-3.69A.75.75 0 018 3.25h4a.75.75 0 01.69.52l1.82 3.69 4.07.59a.75.75 0 01.46.38c.07.2.02.42-.12.59l-2.95 2.87.7 4.05a.75.75 0 01-1.09.79L10 15.85l-3.64 1.91a.75.75 0 01-1.09-.79l.7-4.05L1.03 8.82a.75.75 0 01-.12-.59zM10 13.06l1.9 1a.75.75 0 00.57-.42l.37-2.13-1.54-1.5a.75.75 0 00-.22-.51l1.63-3.3-2.14-.31a.75.75 0 00-.56.2L10 4.14 8.02 6.1a.75.75 0 00-.56-.2L5.32 6.2l1.63 3.3a.75.75 0 00-.22.51l-1.54 1.5.37 2.13a.75.75 0 00.57.42l1.9-1z" clip-rule="evenodd" /></svg>
                Adventures
            </a>
            <a class="category-btn @(filters.Category == "shops" ? "active" : "")"
               href="@GetUrlForCategory("shops")">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.25 2a.75.75 0 00-1.5 0V3.532a.75.75 0 000 1.436V6.25A3.75 3.75 0 006.5 10v-.232a.75.75 0 00-1.5 0V10a5.25 5.25 0 0010.5 0v-.232a.75.75 0 00-1.5 0V10A3.75 3.75 0 0010.25 6.25V5a.75.75 0 000-1.436V2zM4.14 12.06a.75.75 0 00-1.06 1.06l1.06 1.06a.75.75 0 001.06-1.06l-1.06-1.06zM15.86 12.06a.75.75 0 00-1.06 1.06l1.06 1.06a.75.75 0 101.06-1.06l-1.06-1.06zM12 16.25a.75.75 0 01.75-.75h1a.75.75 0 010 1.5h-1a.75.75 0 01-.75-.75zM6.25 15.5a.75.75 0 000 1.5h1a.75.75 0 000-1.5h-1z" clip-rule="evenodd" /></svg>
                Shopping
            </a>
        </div>
        @* --- ⬆️ КОНЕЦ ИЗМЕНЕНИЙ ⬆️ --- *@


        <div class="filter-header" @onclick="ToggleAdvancedFilter">
            <h3>@(!isAdvancedFilterOpen ? "Show" : "Hide") Advanced Filters</h3>
            <span class="filter-toggle-icon @(isAdvancedFilterOpen ? "is-open" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-2h18v2H3Zm0-5v-2h18v2H3Zm0-5V6h18v2H3Z" />
                </svg>
            </span>
        </div>

        <div class="advanced-filters @(isAdvancedFilterOpen ? "is-active" : "")">

            @* ... (остальная часть вашей формы без изменений) ... *@
            <div class="form-group">
                <label>Search (name, description):</label>
                <input type="text"
                       class="form-control"
                       @bind="filters.Q"
                       placeholder="Enter search query..." />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Province/State:</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.Province"
                           placeholder="e.g., Guanacaste Province" />
                </div>

                <div class="form-group">
                    <label>City:</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.City"
                           placeholder="e.g., Playa del Coco" />
                </div>

                <div class="form-group">
                    <label>Name:</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.Name"
                           placeholder="Exact name..." />
                </div>

                <div class="form-group">
                    <label>URL (slug):</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.Url"
                           placeholder="e.g., angels_salon" />
                </div>

            </div>

            <div class="form-group">
                <label>Status:</label>
                <select class="form-control" @bind="filters.Status">
                    <option value="">All statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="pending">Pending</option>
                </select>
            </div>

            <div class="form-group">
                <label>Tags (comma separated):</label>
                <input type="text"
                       class="form-control"
                       @bind="tagsInput"
                       placeholder="e.g., Bank, ATM, wifi" />
                <small>Separate tags with commas</small>
            </div>

            <div class="form-group">
                <label>Tags mode:</label>
                <select class="form-control" @bind="filters.TagsMode">
                    <option value="any">Any tag (OR)</option>
                    <option value="all">All tags (AND)</option>
                </select>
            </div>

            <div class="section-title">Geo Search (optional)</div>

            <div class="form-row">
                <div class="form-group">
                    <label>Latitude:</label>
                    <input type="number"
                           step="0.0001"
                           class="form-control"
                           @bind="latitudeInput"
                           placeholder="50.4501" />
                </div>

                <div class="form-group">
                    <label>Longitude:</label>
                    <input type="number"
                           step="0.0001"
                           class="form-control"
                           @bind="longitudeInput"
                           placeholder="30.5234" />
                </div>

                <div class="form-group">
                    <label>Radius (meters):</label>
                    <input type="number"
                           class="form-control"
                           @bind="distanceInput"
                           placeholder="5000" />
                </div>
            </div>

            <div class="form-group">
                <label>Opening hours:</label>
                <select class="form-control" @bind="isOpenInput">
                    <option value="">All</option>
                    <option value="true">Open only</option>
                    <option value="false">Closed only</option>
                </select>
            </div>

            <div class="section-title">Sorting</div>

            <div class="form-row">
                <div class="form-group">
                    <label>Sort by:</label>
                    <select class="form-control" @bind="filters.SortField">
                        <option value="name">Name</option>
                        <option value="category">Category</option>
                        <option value="status">Status</option>
                        <option value="createdAt">Created date</option>
                        <option value="distance">Distance (geo search)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Order:</label>
                    <select class="form-control" @bind="filters.SortOrder">
                        <option value="ASC">Ascending (A-Z)</option>
                        <option value="DESC">Descending (Z-A)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Results per page:</label>
                    <select class="form-control" @bind="filters.PerPage">
                        <option value="4">4</option>
                        <option value="8">8</option>
                        <option value="12">12</option>
                        <option value="16">16</option>
                        <option value="20">20</option>
                    </select>
                </div>

            </div>
            <div class="button-group">
                <button class="btn btn-primary" @onclick="ApplyFilters">
                    🔍 Apply Filters
                </button>
                <button class="btn btn-secondary" @onclick="ResetFilters">
                    🔄 Reset
                </button>
            </div>
        </div>


    </div>
</div>

@code {

    [Parameter]
    public PlaceFilterParams CurrentFilters { get; set; } = new();

    [Parameter]
    public EventCallback<PlaceFilterParams> OnFilterChanged { get; set; }

    // 'filters' - это ВНУТРЕННЕЕ состояние компонента
    private PlaceFilterParams filters = new();

    // Внутреннее состояние для полей, требующих парсинга
    private string tagsInput = string.Empty;
    private string? latitudeInput;
    private string? longitudeInput;
    private string? distanceInput;
    private string isOpenInput = string.Empty;

    // C# логика для сворачивания фильтров
    private bool isAdvancedFilterOpen = false; // По умолчанию фильтры скрыты

    protected override void OnParametersSet()
    {
        filters = CurrentFilters;

        // Также обновляем UI-поля, которые не привязаны к 'filters' напрямую
        tagsInput = string.Join(", ", filters.Tags ?? new List<string>());
        latitudeInput = filters.Latitude?.ToString();
        longitudeInput = filters.Longitude?.ToString();
        distanceInput = filters.Distance?.ToString();
        isOpenInput = filters.IsOpen?.ToString() ?? string.Empty;
    }

    private void ToggleAdvancedFilter()
    {
        isAdvancedFilterOpen = !isAdvancedFilterOpen;
    }

    // ❌ МЕТОД SetCategory() УДАЛЕН. Он больше не нужен.
    // private async Task SetCategory(string category)
    // {
    //     filters.Category = category;
    //     await ApplyFilters();
    // }

    private async Task ApplyFilters()
    {
        // Parse tags from string
        if (!string.IsNullOrWhiteSpace(tagsInput))
        {
            filters.Tags = tagsInput
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(t => t.Trim())
                .ToList();
        }
        else
        {
            filters.Tags = null;
        }

        // Parse geospatial parameters
        if (double.TryParse(latitudeInput, out double lat))
            filters.Latitude = lat;
        else
            filters.Latitude = null;

        if (double.TryParse(longitudeInput, out double lon))
            filters.Longitude = lon;
        else
            filters.Longitude = null;

        if (double.TryParse(distanceInput, out double dist))
            filters.Distance = dist;
        else
            filters.Distance = null;

        // Parse isOpen filter
        if (bool.TryParse(isOpenInput, out bool isOpen))
            filters.IsOpen = isOpen;
        else
            filters.IsOpen = null;

        filters.Page = 1; // Reset to first page on filter
        if (filters.PerPage <= 0)
            filters.PerPage = 4; // Устанавливаем по умолчанию, если не задано

        await OnFilterChanged.InvokeAsync(filters);
    }

    private async Task ResetFilters()
    {
        // Сбрасываем внутреннее состояние
        filters = new PlaceFilterParams
        {
            Page = 1,
            PerPage = 4
        };
        tagsInput = string.Empty;
        latitudeInput = null;
        longitudeInput = null;
        distanceInput = null;
        isOpenInput = string.Empty;

        // Сообщаем родителю, что фильтры сброшены
        await OnFilterChanged.InvokeAsync(filters);
    }

    // --- ⬇️ НОВЫЙ МЕТОД ⬇️ ---
    // Генерирует URL для <a> ссылок категорий
    private string GetUrlForCategory(string category)
    {
        // Создаем копию текущих фильтров
        var linkFilters = new PlaceFilterParams
        {
            Q = filters.Q,
            Province = filters.Province,
            City = filters.City,
            PerPage = filters.PerPage,
            // Сбрасываем страницу и устанавливаем категорию
            Page = 1,
            Category = category
        };

        return GetQueryString(linkFilters);
    }

    // --- ⬇️ НОВЫЙ МЕТОД (Скопирован из PlacesList.razor) ⬇️ ---
    // Этот метод теперь нужен здесь для GetUrlForCategory
    private string GetQueryString(PlaceFilterParams filters)
    {
        var queryParams = new Dictionary<string, object?>();

        if (!string.IsNullOrEmpty(filters.Q))
            queryParams["Q"] = filters.Q;
        if (!string.IsNullOrEmpty(filters.Category))
            queryParams["Category"] = filters.Category;
        if (!string.IsNullOrEmpty(filters.Province))
            queryParams["Province"] = filters.Province;
        if (!string.IsNullOrEmpty(filters.City))
            queryParams["City"] = filters.City;
        if (filters.Page > 1)
            queryParams["Page"] = filters.Page;
        if (filters.PerPage != 4)
            queryParams["PerPage"] = filters.PerPage;

        var queryString = string.Join("&", queryParams
            .Where(kvp => kvp.Value != null)
            .Select(kvp => $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value.ToString()!)}"));

        return string.IsNullOrEmpty(queryString) ? "/" : $"?{queryString}";
    }
}

