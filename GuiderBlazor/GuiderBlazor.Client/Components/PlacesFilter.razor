@using GuiderBlazor.Shared.Models

<div class="filter-container">
    <div class="filter-card">
        <div class="filter-header" @onclick="ToggleAdvancedFilter">
            <h3>@(!isAdvancedFilterOpen ? "Show" : "Hide") Advanced Filters</h3>
            <span class="filter-toggle-icon @(isAdvancedFilterOpen ? "is-open" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-2h18v2H3Zm0-5v-2h18v2H3Zm0-5V6h18v2H3Z" />
                </svg>
            </span>
        </div>
        
        <div class="form-group">
            <label>Category:</label>
            <div class="category-buttons">
                @* Кнопки категорий (и другие поля) теперь будут
                   правильно отображать активное состояние, т.к. 'filters'
                   обновляется в OnParametersSet.
                 *@
                <button type="button"
                        class="category-btn all @(filters.Category == "" ? "active" : "")"
                        @onclick='async () => await SetCategory("")'>
                    All
                </button>
                <button type="button"
                        class="category-btn services @(filters.Category == "services" ? "active" : "")"
                        @onclick='async () => await SetCategory("services")'>
                    Services
                </button>
                <button type="button"
                        class="category-btn to-eat @(filters.Category == "to-eat" ? "active" : "")"
                        @onclick='async () => await SetCategory("to-eat")'>
                    Foods & Drinks
                </button>
                <button type="button"
                        class="category-btn adventures @(filters.Category == "adventures" ? "active" : "")"
                        @onclick='async () => await SetCategory("adventures")'>
                    Adventures
                </button>
                <button type="button"
                        class="category-btn shops @(filters.Category == "shops" ? "active" : "")"
                        @onclick='async () => await SetCategory("shops")'>
                    Shopping
                </button>
            </div>
        </div>

        <div class="advanced-filters @(isAdvancedFilterOpen ? "is-active" : "")">

            <div class="form-group">
                <label>Search (name, description):</label>
                <input type="text"
                       class="form-control"
                       @bind="filters.Q"
                       placeholder="Enter search query..." />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Province/State:</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.Province"
                           placeholder="e.g., Guanacaste Province" />
                </div>

                <div class="form-group">
                    <label>City:</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.City"
                           placeholder="e.g., Playa del Coco" />
                </div>

                <div class="form-group">
                    <label>Name:</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.Name"
                           placeholder="Exact name..." />
                </div>

                <div class="form-group">
                    <label>URL (slug):</label>
                    <input type="text"
                           class="form-control"
                           @bind="filters.Url"
                           placeholder="e.g., angels_salon" />
                </div>

            </div>

            <div class="form-group">
                <label>Status:</label>
                <select class="form-control" @bind="filters.Status">
                    <option value="">All statuses</option>
                    <option value="active">Active</option>
                    <option value="inactive">Inactive</option>
                    <option value="pending">Pending</option>
                </select>
            </div>

            <div class="form-group">
                <label>Tags (comma separated):</label>
                <input type="text"
                       class="form-control"
                       @bind="tagsInput"
                       placeholder="e.g., Bank, ATM, wifi" />
                <small>Separate tags with commas</small>
            </div>

            <div class="form-group">
                <label>Tags mode:</label>
                <select class="form-control" @bind="filters.TagsMode">
                    <option value="any">Any tag (OR)</option>
                    <option value="all">All tags (AND)</option>
                </select>
            </div>

            <div class="section-title">Geo Search (optional)</div>

            <div class="form-row">
                <div class="form-group">
                    <label>Latitude:</label>
                    <input type="number"
                           step="0.0001"
                           class="form-control"
                           @bind="latitudeInput"
                           placeholder="50.4501" />
                </div>

                <div class="form-group">
                    <label>Longitude:</label>
                    <input type="number"
                           step="0.0001"
                           class="form-control"
                           @bind="longitudeInput"
                           placeholder="30.5234" />
                </div>

                <div class="form-group">
                    <label>Radius (meters):</label>
                    <input type="number"
                           class="form-control"
                           @bind="distanceInput"
                           placeholder="5000" />
                </div>
            </div>
   
            <div class="form-group">
            <label>Opening hours:</label>
            <select class="form-control" @bind="isOpenInput">
                <option value="">All</option>
                <option value="true">Open only</option>
                <option value="false">Closed only</option>
            </select>
        </div>

            <div class="section-title">Sorting</div>

            <div class="form-row">
            <div class="form-group">
                <label>Sort by:</label>
                <select class="form-control" @bind="filters.SortField">
                    <option value="name">Name</option>
                    <option value="category">Category</option>
                    <option value="status">Status</option>
                    <option value="createdAt">Created date</option>
                    <option value="distance">Distance (geo search)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Order:</label>
                <select class="form-control" @bind="filters.SortOrder">
                    <option value="ASC">Ascending (A-Z)</option>
                    <option value="DESC">Descending (Z-A)</option>
                </select>
            </div>

            <div class="form-group">
                <label>Results per page:</label>
                <select class="form-control" @bind="filters.PerPage">
                    <option value="1">1</option>
                    <option value="12">12</option>
                    <option value="20">20</option>
                    <option value="24">24</option>
                    <option value="48">48</option>
                </select>
            </div>
                
        </div>
            <div class="button-group">
                <button class="btn btn-primary" @onclick="ApplyFilters">
                    🔍 Apply Filters
                </button>
                <button class="btn btn-secondary" @onclick="ResetFilters">
                    🔄 Reset
                </button>
            </div>
        </div>

        
    </div>
</div>

@code {

    [Parameter]
    public PlaceFilterParams CurrentFilters { get; set; } = new();

    [Parameter]
    public EventCallback<PlaceFilterParams> OnFilterChanged { get; set; }

    // 'filters' - это ВНУТРЕННЕЕ состояние компонента
    private PlaceFilterParams filters = new();

    // Внутреннее состояние для полей, требующих парсинга
    private string tagsInput = string.Empty;
    private string? latitudeInput;
    private string? longitudeInput;
    private string? distanceInput;
    private string isOpenInput = string.Empty;

    // C# логика для сворачивания фильтров
    private bool isAdvancedFilterOpen = false; // По умолчанию фильтры скрыты

    // ⬇️ ДОБАВЛЕНО: OnParametersSet
    // Этот метод синхронизирует 'filters' (внутреннее состояние)
    // с 'CurrentFilters' (состояние из URL, пришедшее от родителя).
    protected override void OnParametersSet()
    {
        filters = CurrentFilters;

        // Также обновляем UI-поля, которые не привязаны к 'filters' напрямую
        tagsInput = string.Join(", ", filters.Tags ?? new List<string>());
        latitudeInput = filters.Latitude?.ToString();
        longitudeInput = filters.Longitude?.ToString();
        distanceInput = filters.Distance?.ToString();
        isOpenInput = filters.IsOpen?.ToString() ?? string.Empty;
    }

    private void ToggleAdvancedFilter()
    {
        isAdvancedFilterOpen = !isAdvancedFilterOpen;
    }

    private async Task SetCategory(string category)
    {
        filters.Category = category;
        // При нажатии на категорию сразу применяем фильтр
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        // Parse tags from string
        if (!string.IsNullOrWhiteSpace(tagsInput))
        {
            filters.Tags = tagsInput
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(t => t.Trim())
                .ToList();
        }
        else
        {
            filters.Tags = null;
        }

        // Parse geospatial parameters
        if (double.TryParse(latitudeInput, out double lat))
            filters.Latitude = lat;
        else
            filters.Latitude = null;

        if (double.TryParse(longitudeInput, out double lon))
            filters.Longitude = lon;
        else
            filters.Longitude = null;

        if (double.TryParse(distanceInput, out double dist))
            filters.Distance = dist;
        else
            filters.Distance = null;

        // Parse isOpen filter
        if (bool.TryParse(isOpenInput, out bool isOpen))
            filters.IsOpen = isOpen;
        else
            filters.IsOpen = null;

        filters.Page = 1; // Reset to first page on filter
        await OnFilterChanged.InvokeAsync(filters);
    }

    private async Task ResetFilters()
    {
        // Сбрасываем внутреннее состояние
        filters = new PlaceFilterParams();
        tagsInput = string.Empty;
        latitudeInput = null;
        longitudeInput = null;
        distanceInput = null;
        isOpenInput = string.Empty;

        // Сообщаем родителю, что фильтры сброшены
        await OnFilterChanged.InvokeAsync(filters);
    }
}


