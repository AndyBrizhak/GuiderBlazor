@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services

@inject IProvincesService ProvincesService
@inject ICitiesService CitiesService
@inject ITagsService TagsService
@inject NavigationManager Navigation

<div class="filter-container">
    <aside class="filter-card">

        @*  ПОИСК *@
        <search class="search-bar-wrapper" role="search">
            <form method="get" action="/" data-enhance>
                @RenderHiddenInputs()
                <div class="form-group" style="margin-bottom: 0;">
                    <input type="text" name="Q" class="form-control" value="@CurrentFilters.Q"
                           aria-label="Search places" placeholder="Search places, services..." />
                </div>
                <div class="button-group">
                    <button class="btn btn-primary" type="submit"><span>🔍</span><span>Search</span></button>
                    <a href="/" class="btn btn-secondary" data-enhance><span>🔄</span><span>Reset</span></a>
                </div>
            </form>
        </search>

        @* === БЛОК: БЫСТРЫЕ ДЕЙСТВИЯ (Geo + Open) === *@
        <div class="quick-actions-wrapper">

            @* Кнопка Гео *@
            <button type="button"
                    class="hero-geo-btn @(CurrentFilters.Latitude.HasValue ? "active" : "")"
                    onclick="window.toggleGeoLocation()"
                    title="@(CurrentFilters.Latitude.HasValue ? "Turn off geo search" : "Find near me")">

                <svg class="geo-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    @if (CurrentFilters.Latitude.HasValue)
                    {
                        @* Иконка "Выключить" (Крестик или перечеркнутый GPS) *@
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    }
                    else
                    {
                        @* Иконка "Найти" *@
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                    }
                </svg>
                <span>
                    @(CurrentFilters.Latitude.HasValue ? "Clear Geo" : "Find Near Me")
                </span>
            </button>

            @* Переключатель Open Now *@
            @{
                bool nextState = !(CurrentFilters.IsOpen ?? false);
            }
            <a href="@GetUrl(isOpen: nextState)" class="toggle-switch-link" data-enhance
               style="text-decoration: none; display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-primary);">
                <div class="toggle-switch">
                    <input type="checkbox" checked="@(CurrentFilters.IsOpen == true)" disabled style="pointer-events: none;" />
                    <span class="slider"></span>
                </div>
                <span class="toggle-label" style="font-weight: 500; font-size: 0.9rem;">Open Now</span>
            </a>
        </div>
        @* ================================================= *@

        @*  КАТЕГОРИИ - ИСПРАВЛЕНО: используем GetUrlForCategory *@
        <nav class="category-scroller" aria-label="Categories">
            <span class="scroller-label">Category:</span>
            <a class="category-btn chip-all @(string.IsNullOrEmpty(CurrentFilters.Category) ? "active" : "")"
               href="@GetUrlForCategory("")" data-enhance>All</a>
            <a class="category-btn @(CurrentFilters.Category == "services" ? "active" : "")"
               href="@GetUrlForCategory("services")" data-enhance>Services</a>
            <a class="category-btn @(CurrentFilters.Category == "to-eat" ? "active" : "")"
               href="@GetUrlForCategory("to-eat")" data-enhance>Foods</a>
            <a class="category-btn @(CurrentFilters.Category == "adventures" ? "active" : "")"
               href="@GetUrlForCategory("adventures")" data-enhance>Adventures</a>
            <a class="category-btn @(CurrentFilters.Category == "shops" ? "active" : "")"
               href="@GetUrlForCategory("shops")" data-enhance>Shopping</a>
        </nav>

        @*  ПРОВИНЦИИ - ИСПРАВЛЕНО: используем GetUrlForProvince *@
        <nav class="province-scroller" aria-label="Provinces">
            <span class="scroller-label">Province:</span>
            <a href="@GetUrlForProvince("")" class="province-chip chip-all @(string.IsNullOrEmpty(CurrentFilters.Province) ? "active" : "")" data-enhance>All</a>
            @foreach (var province in activeProvinces)
            {
                <a href="@GetUrlForProvince(province.Slug)" class="province-chip @(IsProvinceActive(province.Slug) ? "active" : "")" data-enhance>@province.Name</a>
            }
        </nav>

        @*  ГОРОДА - ИСПРАВЛЕНО: используем GetUrlForCity *@
        <div class="location-controls-wrapper">
            <div class="location-controls">

                @* City Filter Block *@
                <div class="city-filter-block">
                    <details open="@(!string.IsNullOrEmpty(CurrentFilters.City))">
                        <summary class="filter-toggle-btn">
                            City
                            <span class="filter-toggle-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.23 8.29a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
                            </span>
                        </summary>

                        <div class="city-cloud-wrapper is-open">
                            <div class="city-cloud-content">
                                @if (isLoadingCities)
                                {
                                    <span class="chip-tag disabled">Loading...</span>
                                }
                                else if (activeCities.Any())
                                {
                                    <a class="chip-tag chip-all @(string.IsNullOrEmpty(CurrentFilters.City) ? "active" : "")"
                                       href="@GetUrlForCity("")"
                                       data-enhance>
                                        All Cities
                                    </a>
                                    @foreach (var city in activeCities)
                                    {
                                        <a class="chip-tag @(CurrentFilters.City == city ? "active" : "")"
                                           href="@GetUrlForCity(city)"
                                           data-enhance>
                                            @city
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="no-data">No cities for this filter.</span>
                                }
                            </div>
                        </div>
                    </details>
                </div>

            </div>
        </div>

        @*  ТЕГИ *@
        <div class="tags-section">
            <details id="tags-details" open="@(CurrentFilters.Tags != null && CurrentFilters.Tags.Any())">
                <summary class="tags-toggle">
                    <span class="scroller-label">Tags</span>
                    <span class="filter-toggle-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.23 8.29a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
                    </span>
                </summary>
                <div class="tags-content is-open">
                    <div class="form-group">
                        <div class="tag-cloud-container">
                            <a class="chip-tag chip-all @(CurrentFilters.Tags == null || !CurrentFilters.Tags.Any() ? "active" : "")"
                               href="@GetUrl(clearTags: true)" data-enhance>All</a>
                            @if (isLoadingTags)
                            {
                                <span class="chip-tag disabled">Loading tags...</span>
                            }
                            else
                            {
                                var currentTags = CurrentFilters.Tags ?? new List<string>();
                                @foreach (var tag in activeTags)
                                {
                                    bool isSelected = currentTags.Contains(tag);
                                    <a class="chip-tag @(isSelected ? "active" : "")"
                                       href="@GetUrlForTag(tag)" data-enhance>
                                        @tag
                                        @if (isSelected)
                                        {
                                            <span class="chip-remove">×</span>
                                        }
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </details>
        </div>
    </aside>
</div>

@* === MODAL WARNING (Native Dialog) === *@
@* Этот HTML будет существовать только на страницах, где есть PlacesFilter *@
<dialog id="geo-warning-dialog" class="geo-dialog">
    <div class="geo-dialog-content">
        <h3>⚠️ Weak GPS Signal</h3>
        <p id="geo-warning-text">Accuracy is low.</p>
        <div class="geo-dialog-actions">
            <button class="btn btn-secondary" onclick="window.closeGeoDialog(false)">Cancel</button>
            <button class="btn btn-primary" onclick="window.closeGeoDialog(true)">Use Anyway</button>
        </div>
    </div>
</dialog>

@*  СКРИПТ ДЛЯ СОХРАНЕНИЯ СОСТОЯНИЯ *@
<script>
    (function () {
        const detailsId = 'tags-details';
        const storageKey = 'guider_tags_open';

        function initTagsState() {
            const details = document.getElementById(detailsId);
            if (!details) return;

            const savedState = sessionStorage.getItem(storageKey);
            if (savedState === 'true') {
                details.open = true;
            }

            if (!details.dataset.listenerAttached) {
                details.addEventListener('toggle', (e) => {
                    sessionStorage.setItem(storageKey, e.target.open);
                });
                details.dataset.listenerAttached = "true";
            }
        }

        initTagsState();

        if (typeof Blazor !== 'undefined') {
            Blazor.addEventListener('enhancedload', initTagsState);
        }
    })();
</script>


@code {

    [Parameter] public PlaceFilterParams CurrentFilters { get; set; } = new();
    private List<string> activeCities = new();
    private bool isLoadingCities = true;
    private List<string> activeTags = new();
    private bool isLoadingTags = true;
    private List<ProvinceDto> activeProvinces = new();

    protected override async Task OnParametersSetAsync()
    {
        var t1 = LoadActiveCities();
        var t2 = LoadActiveTags();
        var t3 = LoadActiveProvinces();
        await Task.WhenAll(t1, t2, t3);
    }

    private async Task LoadActiveCities()
    {
        isLoadingCities = true;
        activeCities = await CitiesService.GetActiveCitiesAsync(CurrentFilters.Category, CurrentFilters.Province);
        isLoadingCities = false;
    }

    private async Task LoadActiveTags()
    {
        isLoadingTags = true;

        var serviceTags = await TagsService.GetActiveTagsAsync(
            CurrentFilters.Category,
            CurrentFilters.Province,
            CurrentFilters.City,
            CurrentFilters.Tags
        );

        var selectedTags = CurrentFilters.Tags ?? new List<string>();

        activeTags = serviceTags
            .Union(selectedTags)
            .Distinct()
            .OrderByDescending(t => selectedTags.Contains(t))
            .ThenBy(t => t)
            .ToList();

        isLoadingTags = false;
    }

    private async Task LoadActiveProvinces()
    {
        activeProvinces = await ProvincesService.GetActiveProvincesAsync(CurrentFilters.Category);
    }

    private bool IsProvinceActive(string provinceSlug)
    {
        if (string.IsNullOrEmpty(CurrentFilters.Province)) return false;
        return CurrentFilters.Province.Equals(provinceSlug, StringComparison.OrdinalIgnoreCase);
    }

    // ОСНОВНОЙ МЕТОД ГЕНЕРАЦИИ URL
    private string GetUrl(
        string? q = null,
        string? category = null,
        string? province = null,
        string? city = null,
        int? page = null,
        int? perPage = null,
        bool? isOpen = null,
        List<string>? tags = null,
        bool clearTags = false)
    {
        // 1. Определяем базовые значения
        var finalQ = q ?? CurrentFilters.Q;
        var finalCategory = category ?? CurrentFilters.Category;
        var finalProvince = province == "" ? null : (province ?? CurrentFilters.Province);
        var finalCity = city == "" ? null : (city ?? CurrentFilters.City);
        var finalPage = page ?? CurrentFilters.Page;
        var finalPerPage = perPage ?? CurrentFilters.PerPage;
        var finalIsOpen = isOpen ?? CurrentFilters.IsOpen;

        // 2. Определяем финальные теги
        List<string>? finalTags;
        if (clearTags)
        {
            finalTags = null; // Явно очищаем
        }
        else if (tags != null)
        {
            finalTags = tags; // Используем переданные теги
        }
        else
        {
            finalTags = CurrentFilters.Tags; // Используем текущие теги
        }

        // 3. Собираем query string
        var queryParts = new List<string>();

        if (!string.IsNullOrEmpty(finalQ))
            queryParts.Add($"Q={Uri.EscapeDataString(finalQ)}");

        if (!string.IsNullOrEmpty(finalCategory))
            queryParts.Add($"Category={Uri.EscapeDataString(finalCategory)}");

        if (!string.IsNullOrEmpty(finalProvince))
            queryParts.Add($"Province={Uri.EscapeDataString(finalProvince)}");

        if (!string.IsNullOrEmpty(finalCity))
            queryParts.Add($"City={Uri.EscapeDataString(finalCity)}");

        if (finalPage > 1)
            queryParts.Add($"Page={finalPage}");

        if (finalPerPage != 4)
            queryParts.Add($"PerPage={finalPerPage}");

        // Гео-параметры
        if (CurrentFilters.Latitude.HasValue)
            queryParts.Add($"Latitude={CurrentFilters.Latitude}");
        if (CurrentFilters.Longitude.HasValue)
            queryParts.Add($"Longitude={CurrentFilters.Longitude}");
        if (CurrentFilters.Distance.HasValue)
            queryParts.Add($"Distance={CurrentFilters.Distance}");

        if (finalIsOpen == true)
            queryParts.Add("IsOpen=true");

        if (!string.IsNullOrEmpty(CurrentFilters.SortField))
            queryParts.Add($"SortField={CurrentFilters.SortField}");
        if (!string.IsNullOrEmpty(CurrentFilters.SortOrder))
            queryParts.Add($"SortOrder={CurrentFilters.SortOrder}");

        // Добавляем теги
        if (finalTags != null && finalTags.Any())
        {
            foreach (var tag in finalTags)
            {
                if (!string.IsNullOrEmpty(tag))
                {
                    queryParts.Add($"Tags={Uri.EscapeDataString(tag)}");
                }
            }
        }

        return queryParts.Count == 0 ? "/" : $"?{string.Join("&", queryParts)}";
    }

    // СПЕЦИАЛИЗИРОВАННЫЕ МЕТОДЫ ДЛЯ ФИЛЬТРОВ

    /// <summary>
    /// Генерирует URL для категории с очисткой зависимых фильтров
    /// </summary>
    private string GetUrlForCategory(string category)
    {
        // При смене категории:
        // - Сбрасываем провинцию и город (они могут стать недоступны)
        // - Сбрасываем теги (они зависят от категории)
        // - Сбрасываем страницу на 1
        return GetUrl(
            category: category,
            province: "",
            city: "",
            page: 1,
            clearTags: true
        );
    }

    /// <summary>
    /// Генерирует URL для провинции с очисткой зависимых фильтров
    /// </summary>
    private string GetUrlForProvince(string province)
    {
        // При смене провинции:
        // - Сбрасываем город (он зависит от провинции)
        // - Сбрасываем теги (они зависят от локации)
        // - Сбрасываем страницу на 1
        return GetUrl(
            province: province,
            city: "",
            page: 1,
            clearTags: true
        );
    }

    /// <summary>
    /// Генерирует URL для города с очисткой зависимых фильтров
    /// </summary>
    private string GetUrlForCity(string city)
    {
        // При смене города:
        // - Сбрасываем теги (они зависят от города)
        // - Сбрасываем страницу на 1
        return GetUrl(
            city: city,
            page: 1,
            clearTags: true
        );
    }

    /// <summary>
    /// Генерирует URL для переключения тега
    /// </summary>
    private string GetUrlForTag(string tag)
    {
        var currentTags = CurrentFilters.Tags?.ToList() ?? new List<string>();

        if (currentTags.Contains(tag))
        {
            currentTags.Remove(tag);
        }
        else
        {
            currentTags.Add(tag);
        }

        // Передаем явный список тегов
        return GetUrl(
            tags: currentTags.Any() ? currentTags : null,
            page: 1
        );
    }

    // ВСПОМОГАТЕЛЬНЫЕ МЕТОДЫ (для совместимости)

    private PlaceFilterParams CloneFilters(PlaceFilterParams source)
    {
        return new PlaceFilterParams
        {
            Q = source.Q,
            Category = source.Category,
            Province = source.Province,
            City = source.City,
            PerPage = source.PerPage,
            Page = source.Page,
            Tags = source.Tags?.ToList(),
            Latitude = source.Latitude,
            Longitude = source.Longitude,
            Distance = source.Distance,
            SortField = source.SortField,
            SortOrder = source.SortOrder,
            IsOpen = source.IsOpen
        };
    }

    private string GetQueryString(PlaceFilterParams filters)
    {
        var queryParams = new Dictionary<string, object?>();
        if (!string.IsNullOrEmpty(filters.Q)) queryParams["Q"] = filters.Q;
        if (!string.IsNullOrEmpty(filters.Category)) queryParams["Category"] = filters.Category;
        if (!string.IsNullOrEmpty(filters.Province)) queryParams["Province"] = filters.Province;
        if (!string.IsNullOrEmpty(filters.City)) queryParams["City"] = filters.City;
        if (filters.Page > 1) queryParams["Page"] = filters.Page;
        if (filters.PerPage != 4) queryParams["PerPage"] = filters.PerPage;
        if (filters.Latitude.HasValue) queryParams["Latitude"] = filters.Latitude.Value;
        if (filters.Longitude.HasValue) queryParams["Longitude"] = filters.Longitude.Value;
        if (filters.Distance.HasValue) queryParams["Distance"] = filters.Distance.Value;
        if (filters.IsOpen == true) queryParams["IsOpen"] = "true";
        if (!string.IsNullOrEmpty(filters.SortField)) queryParams["SortField"] = filters.SortField;
        if (!string.IsNullOrEmpty(filters.SortOrder)) queryParams["SortOrder"] = filters.SortOrder;

        var queryParts = new List<string>();
        queryParts.AddRange(queryParams.Where(kvp => kvp.Value != null).Select(kvp => $"{Uri.EscapeDataString(kvp.Key)}={Uri.EscapeDataString(kvp.Value.ToString()!)}"));

        if (filters.Tags != null && filters.Tags.Any())
        {
            foreach (var tag in filters.Tags)
            {
                if (!string.IsNullOrEmpty(tag))
                    queryParts.Add($"Tags={Uri.EscapeDataString(tag)}");
            }
        }

        return queryParts.Count == 0 ? "/" : $"?{string.Join("&", queryParts)}";
    }

    private RenderFragment RenderHiddenInputs() => builder =>
    {
        if (!string.IsNullOrEmpty(CurrentFilters.Category))
        {
            builder.OpenElement(0, "input");
            builder.AddAttribute(1, "type", "hidden");
            builder.AddAttribute(2, "name", "Category");
            builder.AddAttribute(3, "value", CurrentFilters.Category);
            builder.CloseElement();
        }
        if (!string.IsNullOrEmpty(CurrentFilters.Province))
        {
            builder.OpenElement(4, "input");
            builder.AddAttribute(5, "type", "hidden");
            builder.AddAttribute(6, "name", "Province");
            builder.AddAttribute(7, "value", CurrentFilters.Province);
            builder.CloseElement();
        }
        if (!string.IsNullOrEmpty(CurrentFilters.City))
        {
            builder.OpenElement(8, "input");
            builder.AddAttribute(9, "type", "hidden");
            builder.AddAttribute(10, "name", "City");
            builder.AddAttribute(11, "value", CurrentFilters.City);
            builder.CloseElement();
        }
        if (CurrentFilters.Tags != null)
        {
            foreach (var tag in CurrentFilters.Tags)
            {
                builder.OpenElement(12, "input");
                builder.AddAttribute(13, "type", "hidden");
                builder.AddAttribute(14, "name", "Tags");
                builder.AddAttribute(15, "value", tag);
                builder.CloseElement();
            }
        }
        if (CurrentFilters.IsOpen == true)
        {
            builder.OpenElement(16, "input");
            builder.AddAttribute(17, "type", "hidden");
            builder.AddAttribute(18, "name", "IsOpen");
            builder.AddAttribute(19, "value", "true");
            builder.CloseElement();
        }
    };
}