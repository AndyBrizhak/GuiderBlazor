                @* <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 2.5c-1.12 0-2.128.23-3.033.642A.75.75 0 006.18 4.028a11.16 11.16 0 017.64 0 .75.75 0 00.784-1.358A12.66 12.66 0 0010 2.5zM4.34 6.002A.75.75 0 014 6.75v.013a11.16 11.16 0 000 6.474.75.75 0 01-1.42.49 12.66 12.66 0 010-7.447.75.75 0 011.06-.49l.7.7zM16.42 14.24a.75.75 0 001.06.49 12.66 12.66 0 000-7.447.75.75 0 00-1.06-.49l-.7.7a.75.75 0 00-.339 1.013c.09.21.16.429.21.657a11.16 11.16 0 010 3.804c-.05.228-.12.447-.21.657a.75.75 0 00.339 1.013l.7.7zM10 17.5a12.66 12.66 0 01-3.033-.642.75.75 0 00-.784 1.358 11.16 11.16 0 007.64 0 .75.75 0 00-.784-1.358A12.66 12.66 0 0110 17.5z" clip-rule="evenodd" />
