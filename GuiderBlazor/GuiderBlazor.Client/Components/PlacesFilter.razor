            <a class="category-btn @(filters.Category == "shops" ? "active" : "")"
               href="@GetUrlForCategory("shops")">
                @* 5. Shopping (Иконка "Сумка") *@
                @* <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.25 3.75A1.5 1.5 0 019.75 2.25h.5a1.5 1.5 0 011.5 1.5v.75c.348 0 .684.043 1.01.125C13.86 3.25 14.828 2 16 2a2 2 0 110 4c-1.172 0-2.14-.25-3.24-.625a.75.75 0 01-.51-.125v.75A1.5 1.5 0 019.75 8.25h-.5A1.5 1.5 0 018.25 6.75v-.75c-.348 0-.684-.043-1.01-.125C6.14 6.75 5.172 8 4 8a2 2 0 110-4c1.172 0 2.14.25 3.24.625a.75.75 0 01.51.125v-.75zM4.5 5a1 1 0 100 2 1 1 0 000-2zM15.5 5a1 1 0 100 2 1 1 0 000-2z" clip-rule="evenodd" />
                    <path d="M6.08 7.42a.75.75 0 01.448.665l.024.18a8.25 8.25 0 001.32.73 1.5 1.5 0 011.258 0 8.25 8.25 0 001.32-.73l.024-.18a.75.75 0 01.448-.665N12 7.218c.55.038 1.08.114 1.591.218a.75.75 0 01.448.665l.024.18a8.25 8.25 0 001.32.73 1.5 1.5 0 011.258 0 8.25 8.25 0 001.32-.73l.024-.18a.75.75 0 01.448-.665C18.66 7.301 20 7.53 20 8.25v6.25A2.5 2.5 0 0117.5 17h-15A2.5 2.5 0 010 14.5V8.25c0-.72.14-1.42.39-2.06a.75.75 0 01.665-.448C1.51 5.854 2.14 6 2.75 6c.61 0 1.24-.146 1.76-.39a.75.75 0 01.665.448C5.49 6.58 6 7.28 6 8v.25c0 .35.03.69.08.1018zM1.5 8.25v6.25a1 1 0 001 1h15a1 1 0 001-1V8.25c0-.22-.02-.43-.06-.63l-.018.003a9.75 9.75 0 01-2.103.882 1.5 1.5 0 01-1.258 0 8.25 8.25 0 00-1.32-.73l-.024-.18a.75.75 0 01.448-.665C13.86 6.75 14.828 6.5 16 6.5a1 1 0 000-1c-1.172 0-2.14.25-3.24.625a.75.75 0 01-.51-.125V5.25a.75.75 0 00-.75-.75h-.5a.75.75 0 00-.75.75v.75a.75.75 0 01-.51.125C8.14 6.75 7.172 7 6 7a1 1 0 100-2c1.172 0 2.14.25 3.24.625a.75.75 0 01.51.125V2.25a.75.75 0 00-.75-.75h-.5a.75.75 0 00-.75.75v.75a.75.75 0 01-.51-.125C6.14 2.25 5.172 2 4 2a1 1 0 100 2c1.172 0 2.14.25 3.24.625a.75.75 0 01.51.125V8c0 .22-.02.43-.06.63l-.018-.003a9.75 9.75 0 01-2.103-.882 1.5 1.5 0 01-1.258 0 8.25 8.25 0 00-1.32.73l-.024-.18a.75.75 0 01-.448.665C3.34 8.2 2.5 8.47 2.5 9.19v-.94z" clip-rule="evenodd" />
