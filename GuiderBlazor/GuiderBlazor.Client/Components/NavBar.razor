@rendermode InteractiveServer
@inject IJSRuntime JSRuntime 


<nav class="main-nav">
    <a href="/" class="nav-brand">Guider.pro</a>

    <button class="theme-toggle" @onclick="ToggleTheme">
        @if (isDarkMode)
        {
            <span class="icon">☀️</span>
        }
        else
        {
            <span class="icon">🌙</span>
        }
    </button>
</nav>

@code {
    // Логика гамбургера
    private bool isNavMenuOpen = false;

    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;
    }

    private bool isDarkMode; // 1. Внутреннее состояние
    private bool hasBeenInitialized = false;

    // 2. Параметр, получаемый от MainLayout
    [Parameter]
    public bool IsDarkModeInitial { get; set; }

    protected override void OnParametersSet()
    {
        // 3. Устанавливаем начальное состояние ТОЛЬКО ОДИН РАЗ
        //    (После этого компонент живет своей жизнью)
        if (!hasBeenInitialized)
        {
            isDarkMode = IsDarkModeInitial;
            hasBeenInitialized = true;
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("applyTheme", isDarkMode ? "dark-theme" : "light-theme");
    }
    
}
