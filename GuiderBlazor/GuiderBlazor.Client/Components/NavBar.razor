@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<nav class="main-nav">
    <a href="/" class="nav-brand">
        <img src="/images/logo.svg" alt="Guider.pro Logo" class="nav-logo" />
    </a>

    <div class="nav-links @(isNavMenuOpen ? "is-active" : "")">
        <a href="/">Home</a>
    </div>

    <div class="nav-actions">

        <button class="theme-toggle" @onclick="ToggleTheme">
            @if (isDarkMode)
            {
                <span class="icon">☀️</span>
            }
            else
            {
                <span class="icon">🌙</span>
            }
        </button>

        <button class="hamburger-button" @onclick="ToggleNavMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</nav>

@code {
    private bool isNavMenuOpen = false;
    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;
    }

    private bool isDarkMode;

    [Parameter]
    public bool IsDarkModeInitial { get; set; }

    protected override void OnInitialized()
    {
        isDarkMode = IsDarkModeInitial;
        // Console.WriteLine($"[NavBar] OnInitialized: isDarkMode={isDarkMode}, IsDarkModeInitial={IsDarkModeInitial}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            // Console.WriteLine($"[NavBar] OnAfterRenderAsync START: firstRender={firstRender}, isDarkMode={isDarkMode}");

            var currentTheme = await JSRuntime.InvokeAsync<bool>("loadTheme");
            // Console.WriteLine($"[NavBar] loadTheme returned: {currentTheme}");

            if (isDarkMode != currentTheme)
            {
                // Console.WriteLine($"[NavBar] MISMATCH! Updating: {isDarkMode} -> {currentTheme}");
                isDarkMode = currentTheme;
                StateHasChanged();
            }
            else
            {
                // Console.WriteLine($"[NavBar] Theme is in sync: {isDarkMode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavBar] ERROR: {ex.Message}");
        }
    }

    protected override void OnParametersSet()
    {
        // Console.WriteLine($"[NavBar] OnParametersSet: isDarkMode={isDarkMode}, IsDarkModeInitial={IsDarkModeInitial}");
        isDarkMode = IsDarkModeInitial;
    }

    private async Task ToggleTheme()
    {
        try
        {
            // Console.WriteLine($"[NavBar] ToggleTheme BEFORE: isDarkMode={isDarkMode}");

            isDarkMode = !isDarkMode;
            var theme = isDarkMode ? "dark-theme" : "light-theme";

            // Console.WriteLine($"[NavBar] ToggleTheme AFTER: isDarkMode={isDarkMode}, theme={theme}");

            await JSRuntime.InvokeVoidAsync("applyTheme", theme);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[NavBar] ToggleTheme ERROR: {ex.Message}");
            isDarkMode = !isDarkMode;
        }
    }
}