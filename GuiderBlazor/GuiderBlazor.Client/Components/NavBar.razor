@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<nav class="main-nav">
    <a href="/" class="nav-brand">
        <img src="/images/logo.svg" alt="Guider.pro Logo" class="nav-logo" />
    </a>

    @* <div class="nav-links @(isNavMenuOpen ? "is-active" : "")">
        <a href="/">Home</a>
        <a href="/category/adventures">Adventures</a>
        <a href="/category/to-eat">Food & Drinks</a>
        <a href="/category/services">Services</a>
    </div> *@

    <div class="nav-actions">

        <button class="theme-toggle" @onclick="ToggleTheme">
            @if (isDarkMode)
            {
                <span class="icon">☀️</span>
            }
            else
            {
                <span class="icon">🌙</span>
            }
        </button>

        <button class="hamburger-button" @onclick="ToggleNavMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</nav>

@code {
    // 1. Логика гамбургера
    private bool isNavMenuOpen = false;

    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;
    }

    // 2. Логика темы
    private bool isDarkMode;

    // ⬇️ 1. НУЖНО: Отслеживать предыдущее состояние
    private bool _previousIsDarkModeInitial;

    [Parameter]
    public bool IsDarkModeInitial { get; set; }

    protected override void OnInitialized()
    {
        // ⬇️ 2. НУЖНО: Установить начальное состояние для C#
        isDarkMode = IsDarkModeInitial;
        _previousIsDarkModeInitial = IsDarkModeInitial;
    }

    protected override void OnParametersSet()
    {
        // ⬇️ 3. НУЖНО: Обновлять C#-состояние при каждой навигации
        // (Это обновит иконку ☀️/🌙)
        isDarkMode = IsDarkModeInitial;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // ⬇️ 4. ГЛАВНОЕ ИСПРАВЛЕНИЕ:
        // Запускаем JS-синхронизацию, если:
        // (a) Это первая загрузка приложения
        // (b) ИЛИ если параметр от MainLayout изменился (т.е. произошла навигация)

        bool parameterChanged = _previousIsDarkModeInitial != IsDarkModeInitial;

        if (firstRender || parameterChanged)
        {
            var theme = isDarkMode ? "dark-theme" : "light-theme";
            await JSRuntime.InvokeVoidAsync("applyTheme", theme);

            // Обновляем наш "трекер"
            _previousIsDarkModeInitial = IsDarkModeInitial;
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;

        // ⬇️ 5. НУЖНО: Обновить "трекер" при клике
        _previousIsDarkModeInitial = isDarkMode;

        await JSRuntime.InvokeVoidAsync("applyTheme", isDarkMode ? "dark-theme" : "light-theme");
    }
}