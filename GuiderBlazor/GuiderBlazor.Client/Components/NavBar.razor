@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<nav class="main-nav">
    <a href="/" class="nav-brand">
        <img src="/images/logo.svg" alt="Guider.pro Logo" class="nav-logo" />
    </a>

    <div class="nav-links @(isNavMenuOpen ? "is-active" : "")">
        <a href="/">Home</a>
        @* <a href="/category/adventures">Adventures</a>
        <a href="/category/to-eat">Food & Drinks</a>
        <a href="/category/services">Services</a> *@
    </div>

    <div class="nav-actions">

        <button class="theme-toggle" @onclick="ToggleTheme">
            @if (isDarkMode)
            {
                <span class="icon">☀️</span>
            }
            else
            {
                <span class="icon">🌙</span>
            }
        </button>

        <button class="hamburger-button" @onclick="ToggleNavMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</nav>

@code {
    // 1. Логика гамбургера
    private bool isNavMenuOpen = false;
    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;
    }

    // 2. Логика темы (УПРОЩЕНО)

    // Это внутреннее C#-состояние, оно управляет ТОЛЬКО иконкой ☀️/🌙
    private bool isDarkMode;

    // Этот параметр приходит из MainLayout (который читает cookie)
    [Parameter]
    public bool IsDarkModeInitial { get; set; }

    // Устанавливаем состояние иконки при первой загрузке
    protected override void OnInitialized()
    {
        isDarkMode = IsDarkModeInitial;
    }

    // Устанавливаем состояние иконки при навигации
    // (когда сервер повторно рендерит MainLayout)
    protected override void OnParametersSet()
    {
        isDarkMode = IsDarkModeInitial;
    }

    // Этот метод - ЕДИНСТВЕННОЕ место, которое меняет тему
    private async Task ToggleTheme()
    {
        // 1. Меняем C# состояние (для иконки)
        isDarkMode = !isDarkMode;

        // 2. Вызываем JS, который сделает всю работу
        // (установит <html>.className, localStorage И cookie)
        var theme = isDarkMode ? "dark-theme" : "light-theme";
        await JSRuntime.InvokeVoidAsync("applyTheme", theme);
    }
}
