@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<nav class="main-nav">
    <a href="/" class="nav-brand">Guider.pro</a>

    <div class="nav-links @(isNavMenuOpen ? "is-active" : "")">
        <a href="/">Home</a>
        <a href="/category/adventures">Adventures</a>
        <a href="/category/to-eat">Food & Drinks</a>
        <a href="/category/services">Services</a>
    </div>

    <div class="nav-actions">

        <button class="theme-toggle" @onclick="ToggleTheme">
            @if (isDarkMode)
            {
                <span class="icon">☀️</span>
            }
            else
            {
                <span class="icon">🌙</span>
            }
        </button>

        <button class="hamburger-button" @onclick="ToggleNavMenu">
            <span></span>
            <span></span>
            <span></span>
        </button>

    </div>
</nav>

@code {
    // 1. Логика гамбургера (она у вас уже была и работала)
    private bool isNavMenuOpen = false;

    private void ToggleNavMenu()
    {
        isNavMenuOpen = !isNavMenuOpen;
    }

    // 2. Логика темы (остается без изменений)
    private bool isDarkMode;
    private bool hasBeenInitialized = false;

    [Parameter]
    public bool IsDarkModeInitial { get; set; }

    protected override void OnParametersSet()
    {
        if (!hasBeenInitialized)
        {
            isDarkMode = IsDarkModeInitial;
            hasBeenInitialized = true;
        }
    }

    private async Task ToggleTheme()
    {
        isDarkMode = !isDarkMode;
        await JSRuntime.InvokeVoidAsync("applyTheme", isDarkMode ? "dark-theme" : "light-theme");
    }
}