@inject NavigationManager Navigation

<nav class="main-nav">
    <a href="/" class="nav-brand">
        <img src="/images/logo.svg" alt="Guider.pro Logo" class="nav-logo" />
    </a>

    <div id="nav-links" class="nav-links">
        <a href="/">Home</a>
    </div>

    <div class="nav-actions">
        <button class="theme-toggle" id="theme-toggle-btn" onclick="toggleThemeJs()">
            <span class="icon" id="theme-icon">@(IsDarkModeInitial ? "☀️" : "🌙")</span>
        </button>

        <button class="hamburger-button" onclick="toggleMenuJs()">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</nav>

<script>
    function toggleMenuJs() {
        const navLinks = document.getElementById('nav-links');
        navLinks.classList.toggle('is-active');
    }

    function toggleThemeJs() {
        // ВАЖНО: Согласно вашему app.css, класс должен быть на теге <html>
        // document.documentElement - это и есть тег <html>
        const htmlElement = document.documentElement;

        // Переключаем класс
        const isDark = htmlElement.classList.toggle('dark-theme');

        // Меняем иконку
        const icon = document.getElementById('theme-icon');
        icon.innerText = isDark ? '☀️' : '🌙';

        // Сохраняем состояние для будущих запросов (Cookie для сервера, LocalStorage для клиента)
        document.cookie = "theme=" + (isDark ? "dark-theme" : "light-theme") + "; path=/; max-age=31536000";
        localStorage.setItem('theme', isDark ? 'dark-theme' : 'light-theme');
    }
</script>

@code {
    [Parameter]
    public bool IsDarkModeInitial { get; set; }
}