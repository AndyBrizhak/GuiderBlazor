@using GuiderBlazor.Client.Models
@inject NavigationManager Navigation

<div class="place-card" @onclick="NavigateToDetails">
    <div class="card-image">
        @if (Place.ImgLink?.Any() == true)
        {
            <img src="@Place.ImgLink.First()" alt="@Place.Name" />
        }
        else
        {
            <div class="no-image">
                <span>No Image</span>
            </div>
        }
    </div>

    <div class="card-content">
        <h3 class="card-title">@Place.Name</h3>

        <div class="card-category">
            <span class="category-badge">@Place.Category</span>
        </div>

        @if (Place.Tags?.Any() == true)
        {
            <div class="card-tags">
                @foreach (var tag in Place.Tags.Take(3))
                {
                    <span class="tag">@tag</span>
                }
            </div>
        }

        @if (Place.Address != null)
        {
            <div class="card-location">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>@Place.Address.City, @Place.Address.Country</span>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Place Place { get; set; } = null!;

    private void NavigateToDetails()
    {
        Navigation.NavigateTo($"/place/{Place.Id}");
    }
}

<style>
    .place-card {
        background: white;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        cursor: pointer;
        transition: transform 0.3s, box-shadow 0.3s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .place-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        }

    .card-image {
        width: 100%;
        height: 200px;
        overflow: hidden;
        background: #f0f0f0;
    }

        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .no-image {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        font-weight: 500;
    }

    .card-content {
        padding: 1.25rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-title {
        margin: 0 0 0.75rem 0;
        font-size: 1.25rem;
        font-weight: 600;
        color: #333;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .card-category {
        margin-bottom: 0.75rem;
    }

    .category-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: #e3f2fd;
        color: #1976d2;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 500;
        text-transform: capitalize;
    }

    .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .tag {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        background: #f5f5f5;
        color: #666;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .card-location {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #666;
        font-size: 0.9rem;
        margin-top: auto;
    }

        .card-location svg {
            flex-shrink: 0;
        }
</style>
