@using GuiderBlazor.Shared.Models
@inject NavigationManager Navigation // Этот инжект больше не нужен, но если он используется где-то еще в компоненте, оставьте.

<a href="/place/@Place.Url" class="place-card">
    <div class="card-image">
        @if (Place.ImgLink?.Any() == true)
        {
            <img src="@Place.ImgLink.First()" alt="@Place.Name" />
        }
        else
        {
            <div class="no-image">
                <span>No image</span>
            </div>
        }
    </div>

    <div class="card-content">
        <h3 class="card-title">@Place.Name</h3>
        <p class="card-address">
            @if (!string.IsNullOrEmpty(Place.Address?.City))
            {
                <span>@Place.Address.City</span>
            }
            @if (!string.IsNullOrEmpty(Place.Address?.Province) && !string.IsNullOrEmpty(Place.Address?.City))
            {
                <span>, @Place.Address.Province</span>
            }
            else if (!string.IsNullOrEmpty(Place.Address?.Province))
            {
                <span>@Place.Address.Province</span>
            }
        </p>
        <div class="card-tags">
            @foreach (var tag in Place.Tags ?? new List<string>())
            {
                @if (!string.IsNullOrEmpty(tag))
                {
                    <span class="tag">@tag</span>
                }
            }
        </div>
    </div>
</a>

@code {
    [Parameter, EditorRequired]
    public Place Place { get; set; } = null!;

    // Метод NavigateToDetails() больше не нужен, так как мы используем обычную ссылку <a>
