@page "/"
@page "/category/{CategorySlug}"
@page "/province/{ProvinceSlug}"
@page "/city/{CitySlug}"
@page "/category/{CategorySlug}/province/{ProvinceSlug}"
@page "/category/{CategorySlug}/city/{CitySlug}"
@page "/province/{ProvinceSlug}/city/{CitySlug}"
@page "/category/{CategorySlug}/province/{ProvinceSlug}/city/{CitySlug}"

@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services
@using GuiderBlazor.Client.Components
@* @using GuiderBlazor.Client.Services *@
@using Microsoft.AspNetCore.OutputCaching
@using System.Text
@using System.Web

@inject IPlacesService PlacesService
@inject NavigationManager Navigation

@attribute [StreamRendering]
@attribute [OutputCache(PolicyName = "HomePage")]

<PageTitle>@SeoTitle</PageTitle>

<HeadContent>
    <meta name="description" content="@SeoDescription" />
    <meta name="robots" content="@RobotsTag" />
    <link rel="canonical" href="@CanonicalUrl" />

    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Navigation.Uri" />
    <meta property="og:image" content="@(Navigation.BaseUri + "logo.svg")" />
    <meta property="og:site_name" content="Guider Costa Rica" />
</HeadContent>

<div class="home-container">
    <section class="hero-section" aria-labelledby="hero-title">
        <h1 id="hero-title">
            @H1Title
        </h1>
    </section>

    <PlacesList PlacesResponse="placesResponse"
                CurrentFilters="currentFilters"
                IsLoading="isLoading" />
</div>

@code {
    // === ПАРАМЕТРЫ МАРШРУТА (из пути URL с явными префиксами) ===
    [Parameter] public string? CategorySlug { get; set; }
    [Parameter] public string? ProvinceSlug { get; set; }
    [Parameter] public string? CitySlug { get; set; }

    // === ПАРАМЕТРЫ QUERY-STRING ===
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "Tags")] public string[]? Tags { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery] public int PerPage { get; set; } = 4;
    [SupplyParameterFromQuery] public double? Latitude { get; set; }
    [SupplyParameterFromQuery] public double? Longitude { get; set; }
    [SupplyParameterFromQuery] public double? Distance { get; set; }
    [SupplyParameterFromQuery] public string? SortField { get; set; }
    [SupplyParameterFromQuery] public string? SortOrder { get; set; }
    [SupplyParameterFromQuery] public bool? IsOpen { get; set; }

    // === ВНУТРЕННЕЕ СОСТОЯНИЕ ===
    private PlacesResponse? placesResponse;
    private PlaceFilterParams currentFilters = new();
    private bool isLoading = true;

    // Нормализованные значения для фильтров (из slug)
    private string? Category => CategorySlug != null ? SemanticUrlHandler.NormalizeSlug(CategorySlug) : null;
    private string? Province => ProvinceSlug != null ? SemanticUrlHandler.NormalizeSlug(ProvinceSlug) : null;
    private string? City => CitySlug != null ? SemanticUrlHandler.NormalizeSlug(CitySlug) : null;

    // === SEO ЛОГИКА ===
    private string SeoTitle
    {
        get
        {
            if (!string.IsNullOrEmpty(Q)) return $"Search results for \"{Q}\" | Guider";

            var sb = new StringBuilder();

            // Что ищем?
            if (!string.IsNullOrEmpty(Category))
                sb.Append($"{FormatText(Category)} ");
            else if (Tags != null && Tags.Any())
                sb.Append($"{string.Join(", ", Tags)} ");
            else
                sb.Append("Local Business & Services ");

            // Где ищем?
            if (!string.IsNullOrEmpty(City))
            {
                sb.Append($"in {SemanticUrlHandler.SlugToTitle(City)}");
                // Если есть и город, и провинция - показываем оба
                if (!string.IsNullOrEmpty(Province))
                    sb.Append($", {SemanticUrlHandler.SlugToTitle(Province)} ");
                else
                    sb.Append(" ");
            }
            else if (!string.IsNullOrEmpty(Province))
            {
                sb.Append($"in {SemanticUrlHandler.SlugToTitle(Province)} ");
            }
            else
            {
                sb.Append("in Costa Rica ");
            }

            sb.Append("| Guider.pro");
            return sb.ToString();
        }
    }

    private string SeoDescription
    {
        get
        {
            if (!string.IsNullOrEmpty(Q))
                return $"Search results for {Q} in Costa Rica. Find best places matching your request on Guider.";

            var what = !string.IsNullOrEmpty(Category)
                ? FormatText(Category)
                : "best places and services";

            var where = !string.IsNullOrEmpty(City)
                ? $"{SemanticUrlHandler.SlugToTitle(City)}" +
                  (!string.IsNullOrEmpty(Province) ? $", {SemanticUrlHandler.SlugToTitle(Province)}" : ", Costa Rica")
                : (!string.IsNullOrEmpty(Province)
                    ? SemanticUrlHandler.SlugToTitle(Province)
                    : "Costa Rica");

            return $"Discover the {what} in {where}. Read reviews, check opening hours, view photos and get directions on Guider Business Directory.";
        }
    }

    private string H1Title => SeoTitle.Replace("| Guider.pro", "").Trim();

    private string RobotsTag
    {
        get
        {
            // Закрываем от индексации:
            // 1. Поиск по тексту (Q)
            // 2. Гео-поиск (Latitude)
            // 3. Кастомные сортировки
            // 4. Пагинация (Page > 1)
            if (!string.IsNullOrEmpty(Q) ||
                Latitude.HasValue ||
                !string.IsNullOrEmpty(SortField) ||
                (Page > 1))
            {
                return "noindex, follow";
            }

            return "index, follow";
        }
    }

    private string CanonicalUrl
    {
        get
        {
            var baseUrl = $"{Navigation.BaseUri.TrimEnd('/')}{SemanticUrlHandler.BuildPath(Category, Province, City)}";

            var query = HttpUtility.ParseQueryString(string.Empty);

            // Добавляем только теги в канонический URL
            if (Tags != null)
                foreach (var t in Tags)
                    query.Add("Tags", t);

            return query.HasKeys() ? $"{baseUrl}?{query}" : baseUrl;
        }
    }

    private string FormatText(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        var text = input.Replace("-", " ");
        return char.ToUpper(text[0]) + text.Substring(1);
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        currentFilters = new PlaceFilterParams
        {
            Q = Q,
            Category = Category,
            Province = Province,
            City = City,
            Page = Page < 1 ? 1 : Page,
            PerPage = PerPage < 1 ? 4 : PerPage,
            Status = "active",
            Tags = Tags?.ToList(),
            Latitude = Latitude,
            Longitude = Longitude,
            Distance = Distance,
            SortField = SortField,
            SortOrder = SortOrder,
            IsOpen = IsOpen
        };

        try
        {
            placesResponse = await PlacesService.GetPlacesAsync(currentFilters);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading places: {ex.Message}");
            placesResponse = new PlacesResponse { Places = new List<Place>(), TotalCount = 0 };
        }
        finally
        {
            isLoading = false;
        }
    }
}
