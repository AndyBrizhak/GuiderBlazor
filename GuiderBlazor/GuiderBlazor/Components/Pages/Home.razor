@page "/"
@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services
@using GuiderBlazor.Client.Components
@using Microsoft.AspNetCore.OutputCaching
@using System.Text
@using System.Web

@inject IPlacesService PlacesService
@inject NavigationManager Navigation

@* 1. StreamRendering для быстрой отдачи "скелета" при долгих запросах *@
@attribute [StreamRendering]

@* 2. OutputCache: Полагаемся на политику "HomePage", которая уже настроена в SmartHomePagePolicy.cs *@
@attribute [OutputCache(PolicyName = "HomePage")]

<PageTitle>@SeoTitle</PageTitle>

<HeadContent>
    @* Мета-описание *@
    <meta name="description" content="@SeoDescription" />

    @* Управление индексацией (Index/Noindex) *@
    <meta name="robots" content="@RobotsTag" />

    @* Каноническая ссылка (защита от дублей) *@
    <link rel="canonical" href="@CanonicalUrl" />

    @* Open Graph для красивых ссылок в соцсетях *@
    <meta property="og:title" content="@SeoTitle" />
    <meta property="og:description" content="@SeoDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@Navigation.Uri" />
    @*  ВАЖНО! Перед production  деплоя добавить дефолтную картинку для шеринга *@
    @* Идеальный размер для соцсетей — 1200 x 630 пикселей. *@
    <meta property="og:image" content="@(Navigation.BaseUri + "logo.svg")" />
    @* <meta property="og:image" content="https://guider.pro/images/og-share-default.jpg" /> *@
    <meta property="og:site_name" content="Guider Costa Rica" />
</HeadContent>

<div class="home-container">
    <section class="hero-section" aria-labelledby="hero-title">
        @* Динамический заголовок H1 *@
        <h1 id="hero-title">
            @H1Title
        </h1>
    </section>

    <PlacesList PlacesResponse="placesResponse"
                CurrentFilters="currentFilters"
                IsLoading="isLoading" />
</div>

@code {
    // === 1. ПАРАМЕТРЫ URL ===
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Category { get; set; }
    [SupplyParameterFromQuery] public string? Province { get; set; }
    [SupplyParameterFromQuery] public string? City { get; set; }
    [SupplyParameterFromQuery(Name = "Tags")] public string[]? Tags { get; set; }
    [SupplyParameterFromQuery] public int Page { get; set; } = 1;
    [SupplyParameterFromQuery] public int PerPage { get; set; } = 4;

    // Технические параметры
    [SupplyParameterFromQuery] public double? Latitude { get; set; }
    [SupplyParameterFromQuery] public double? Longitude { get; set; }
    [SupplyParameterFromQuery] public double? Distance { get; set; }
    [SupplyParameterFromQuery] public string? SortField { get; set; }
    [SupplyParameterFromQuery] public string? SortOrder { get; set; }
    [SupplyParameterFromQuery] public bool? IsOpen { get; set; }

    // === 2. ВНУТРЕННЕЕ СОСТОЯНИЕ ===
    private PlacesResponse? placesResponse;
    private PlaceFilterParams currentFilters = new();
    private bool isLoading = true;

    // === 3. SEO ЛОГИКА ===

    // Заголовок вкладки браузера и поисковой выдачи
    private string SeoTitle
    {
        get
        {
            if (!string.IsNullOrEmpty(Q)) return $"Search results for \"{Q}\" | Guider";
            var sb = new StringBuilder();

            // 1. ЧТО ищем
            string categoryName = !string.IsNullOrEmpty(Category)
                ? GetHumanReadableCategory(Category)
                : "Best Places & Services";
            sb.Append(categoryName);
            sb.Append(" ");

            // 2. ГДЕ ищем
            if (!string.IsNullOrEmpty(City))
            {
                // Для города форматирование уже было, оставляем
                sb.Append($"in {FormatText(City)}, Costa Rica");
            }
            else if (!string.IsNullOrEmpty(Province))
            {
                                
                sb.Append($"in {FormatText(Province)} Province");
            }
            else
            {
                sb.Append("in Costa Rica");
            }

            sb.Append(" | Guider.pro");
            return sb.ToString();
        }
    }

    // Мета-описание ( сниппет в Google)
    private string SeoDescription
    {
        get
        {
            if (!string.IsNullOrEmpty(Q)) return $"Search results for {Q}...";

            // 1. Получаем красивые названия
            var what = !string.IsNullOrEmpty(Category) ? GetHumanReadableCategory(Category) : "local businesses";
            var verb = GetCategoryActionVerb(Category); // <--- ВНЕДРЕНИЕ ЗДЕСЬ

            // 2. Формируем локацию
            var where = "Costa Rica";
            if (!string.IsNullOrEmpty(City)) where = $"{FormatText(City)}, {FormatText(Province)}";
            else if (!string.IsNullOrEmpty(Province)) where = $"{FormatText(Province)} Province";

            // 3. Формируем "умное" предложение
            // Было: "Looking for {what} in {where}? ..."
            // Стало: "Planning to eat in Tamarindo? ..." или "Planning to shop in Guanacaste? ..."
            return $"Planning to {verb} in {where}? Discover the best {what}, check opening hours, read reviews and get directions on Guider Business Directory.";
        }
    }

    // Видимый заголовок на странице
    private string H1Title => SeoTitle.Replace("| Guider.pro", "").Trim();

    // Инструкции для роботов
    private string RobotsTag
    {
        get
        {
            // Закрываем от индексации "мусорные" страницы:
            // 1. Результаты поиска по тексту (Q)
            // 2. Поиск по координатам (Latitude)
            // 3. Сортировки отличные от дефолтных
            // 4. Пагинация (Page > 1) - чтобы вес оставался на первой странице
            if (!string.IsNullOrEmpty(Q) ||
                Latitude.HasValue ||
                !string.IsNullOrEmpty(SortField) ||
                (Page > 1))
            {
                return "noindex, follow";
            }

            return "index, follow";
        }
    }

    // Канонический URL (очищенный от технических параметров)
    private string CanonicalUrl
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            var baseUri = uri.GetLeftPart(UriPartial.Path);

            var query = HttpUtility.ParseQueryString(string.Empty);

            // Добавляем ТОЛЬКО параметры, формирующие "посадочную страницу"
            if (!string.IsNullOrEmpty(Category)) query["Category"] = Category;
            if (!string.IsNullOrEmpty(Province)) query["Province"] = Province;
            if (!string.IsNullOrEmpty(City)) query["City"] = City;

            
            // Мы НЕ добавляем Tags, SortField, Page, Latitude и т.д.

            return query.HasKeys() ? $"{baseUri}?{query}" : baseUri;
        }
    }

    // Вспомогательный метод для форматирования текста (services -> Services, to-eat -> To Eat)
    private string FormatText(string input)
    {
        if (string.IsNullOrEmpty(input)) return "";
        // Заменяем дефисы на пробелы и делаем первую букву заглавной
        var text = input.Replace("-", " ");
        return char.ToUpper(text[0]) + text.Substring(1);
    }

    private string GetCategoryActionVerb(string? slug)
    {
        if (string.IsNullOrEmpty(slug)) return "visit";

        return slug.ToLower() switch
        {
            "to-eat" => "eat",         // Planning to eat in...
            "shops" => "shop",         // Planning to shop in...
            "adventures" => "explore", // Planning to explore in...
            _ => "visit"               // Planning to visit...
        };
    }

    private string GetHumanReadableCategory(string? slug)
    {
        if (string.IsNullOrEmpty(slug)) return "Local Business & Services"; // Дефолтное значение

        return slug.ToLower() switch
        {
            "to-eat" => "Best Restaurants & Food",      // Ключевик: Restaurants
            "services" => "Essential Services",         // Ключевик: Services
            "adventures" => "Tours & Adventures",       // Ключевик: Tours
            "shops" => "Shops & Stores",                // Ключевик: Shops
            _ => FormatText(slug) // Фоллбэк на старую логику
        };
    }

    // === 4. ЗАГРУЗКА ДАННЫХ ===
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;

        currentFilters = new PlaceFilterParams
        {
            Q = Q,
            Category = Category,
            Province = Province,
            City = City,
            Page = Page < 1 ? 1 : Page,
            PerPage = PerPage < 1 ? 4 : PerPage,
            Status = "active",
            Tags = Tags?.ToList(),
            Latitude = Latitude,
            Longitude = Longitude,
            Distance = Distance,
            SortField = SortField,
            SortOrder = SortOrder,
            IsOpen = IsOpen
        };

        try
        {
            placesResponse = await PlacesService.GetPlacesAsync(currentFilters);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading places: {ex.Message}");
            // Можно инициализировать пустой список, чтобы не падало
            placesResponse = new PlacesResponse { Places = new List<Place>(), TotalCount = 0 };
        }
        finally
        {
            isLoading = false;
        }
    }


}

