@page "/place/{id}"
@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services
@attribute [StreamRendering]
@inject IPlacesService PlacesService


<PageTitle>@(place?.Name ?? "Loading...")</PageTitle>

<div class="place-details-container">
    @if (isLoading)
    {
        <div class="loading">
            <div class="spinner"></div>
            <p>Loading information...</p>
        </div>
    }
    else if (place != null)
    {
        <div class="details-header">
            <a href="/" class="btn-back">← Back to list</a>

            <h1>@place.Name</h1>
            <span class="category-badge">@place.Category</span>
        </div>

        @if (place.ImgLink?.Any() == true)
        {
            <div class="image-gallery">
                @if (place.ImgLink.Count == 1)
                {
                    <img src="@place.ImgLink[0]" alt="@place.Name" class="single-image" />
                }
                else
                {
                    <div class="gallery-grid">
                        @foreach (var img in place.ImgLink.Take(6))
                        {
                            <img src="@img" alt="@place.Name" />
                        }
                    </div>
                }
            </div>
        }

        <div class="details-content">

            @if (!string.IsNullOrEmpty(place.Description))
            {
                <div class="info-section">
                    <h2>Description</h2>
                    <div class="description">@((MarkupString)place.Description)</div>
                </div>
            }

            <div class="info-section">
                <h2>Info</h2>
                @if (place.Address != null)
                {
                    // 1. Собираем адрес из существующих полей, которые не пустые
                    var addressParts = new List<string>();
                    if (!string.IsNullOrEmpty(place.Address.Street)) { addressParts.Add(place.Address.Street); }
                    if (!string.IsNullOrEmpty(place.Address.City)) { addressParts.Add(place.Address.City); }
                    if (!string.IsNullOrEmpty(place.Address.Province)) { addressParts.Add(place.Address.Province); }
                    if (!string.IsNullOrEmpty(place.Address.Country)) { addressParts.Add(place.Address.Country); } // ⬅️ ИСПРАВЛЕНО

                    // 2. Показываем блок, только если есть хотя бы одна часть адреса
                    if (addressParts.Any())
                    {
                        <div class="info-item">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>
                            <div>
                                <strong>Address:</strong><br />
                                @string.Join(", ", addressParts)
                            </div>
                        </div>
                    }
                }
                @if (!string.IsNullOrEmpty(place.Phone?.Callable))
                {
                    <div class="info-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                        </svg>
                        <div>
                            <strong>Phone:</strong><br />
                            <a href="tel:+@place.Phone.Callable">+@place.Phone.Callable</a>
                        </div>
                    </div>
                }

            </div>

            @if (place.Location?.Coordinates?.Any() == true)
            {
                <div class="info-section">
                    <h2>Location</h2>
                    <div class="map-placeholder">
                        <p>Coordinates: @place.Location.Coordinates[1], @place.Location.Coordinates[0]</p>
                        <a href="https://www.google.com/maps?q=@place.Location.Coordinates[1],@place.Location.Coordinates[0]" target="_blank" class="btn-map">
                            Open in Google Maps
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="error-message">
            <h2>Place not found</h2>
            <p>Unfortunately, information about this place is not available.</p>
                      
            <a href="/" class="btn-back">← Back to list</a>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private Place? place;
    private bool isLoading = true;

    // 🏆 Оставляем ТОЛЬКО OnParametersSetAsync для загрузки с параметром.
    protected override async Task OnParametersSetAsync()
    {
        // Убедимся, что ID не пустой
        if (string.IsNullOrEmpty(Id))
        {
            isLoading = false;
            place = null;
            return;
        }

        // 1. Устанавливаем флаг, чтобы показать спиннер
        isLoading = true;

        // 2. Выполняем загрузку данных ОДИН РАЗ
        place = await PlacesService.GetPlaceByIdAsync(Id);

        // 3. Загрузка завершена
        isLoading = false;
    }

    // P.S. Все остальные методы (OnInitializedAsync и LoadPlace) удалены.
}


