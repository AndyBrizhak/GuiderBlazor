@page "/place/{url}"
@using GuiderBlazor.Shared.Models
@using GuiderBlazor.Shared.Services
@using GuiderBlazor.Shared.Models.JsonLd
@using System.Text.Json
@using System.Text.Json.Serialization
@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.OutputCaching
@inject IHttpContextAccessor HttpContextAccessor

@* Атрибут кэширования *@
@* Ссылаемся на политику "PlaceDetails" из Program.cs *@
@attribute [OutputCache(PolicyName = "PlaceDetails")]

@inject IPlacesService PlacesService
@inject NavigationManager Navigation

<PageTitle>@(place?.Name ?? "Loading...") - Guider</PageTitle>

@if (!string.IsNullOrEmpty(jsonLdBusiness))
{
    <script type="application/ld+json">
        @((MarkupString)jsonLdBusiness)
    </script>
}

@if (!string.IsNullOrEmpty(jsonLdBreadcrumbs))
{
    <script type="application/ld+json">
        @((MarkupString)jsonLdBreadcrumbs)
    </script>
}

@if (place != null && !string.IsNullOrEmpty(place.Description))
{
    <HeadContent>
        @{
            var cleanDesc = System.Text.RegularExpressions.Regex.Replace(place.Description, "<.*?>", "").Replace("\"", "'");
            var shortDesc = cleanDesc.Length > 160 ? cleanDesc.Substring(0, 160) + "..." : cleanDesc;
        }
        <meta name="description" content="@shortDesc" />
    </HeadContent>
}


@* Эта логика @if (isLoading) выполняtся ИСКЛЮЧИТЕЛЬНО на сервере.
  Клиент (и бот) НИКОГДА не увидит <div class="loading">.
  Он получит сразу либо <article>, либо <div class="error-message">.
*@
@if (isLoading)
{
    <div class="loading">
        <div class="spinner"></div>
        <p>Loading information...</p>
    </div>
}
else if (place != null)
{
    <article class="place-details-container" itemscope itemtype="http://schema.org/@(GetBusinessType(place.Category))">

        <div class="details-header">
            <h1 itemprop="name">@place.Name</h1>

            @if (place.Address != null && !string.IsNullOrEmpty(place.Address.City))
            {
                <span class="place-city" itemprop="addressLocality">@place.Address.City</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(place.Category) &&
            place.Address != null &&
            !string.IsNullOrEmpty(place.Address.Province))
        {
            <nav aria-label="breadcrumb">
                <ol class="breadcrumbs"
                    itemscope
                    itemtype="https://schema.org/BreadcrumbList">

                    <li itemprop="itemListElement"
                        itemscope
                        itemtype="https://schema.org/ListItem">
                        <a href="/" itemprop="item">
                            <span itemprop="name">Home</span>
                        </a>
                        <meta itemprop="position" content="1" />
                    </li>

                    <li itemprop="itemListElement"
                        itemscope
                        itemtype="https://schema.org/ListItem">
                        <a href="/?Category=@place.Category" itemprop="item">
                            <span itemprop="name">@FormatCategoryName(place.Category)</span>
                        </a>
                        <meta itemprop="position" content="2" />
                    </li>

                    <li itemprop="itemListElement"
                        itemscope
                        itemtype="https://schema.org/ListItem">
                        <a href="/?Category=@place.Category&Province=@place.Address.Province"
                           itemprop="item">
                            <span itemprop="name">@FormatProvinceName(place.Address.Province)</span>
                        </a>
                        <meta itemprop="position" content="3" />
                    </li>

                    <li itemprop="itemListElement"
                        itemscope
                        itemtype="https://schema.org/ListItem">
                        <span itemprop="name" aria-current="page">@place.Name</span>
                        <meta itemprop="position" content="4" />
                    </li>
                </ol>
            </nav>
        }

        @if (place.ImgLink?.Any() == true)
        {
            <div class="horizontal-scroll-container"
                 aria-label="Image Gallery"
                 role="region">

                <ul class="scroll-track">
                    @foreach (var img in place.ImgLink)
                    {
                        <li class="scroll-item">
                            <a href="@img"
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="View full-size image"
                               itemprop="image">

                                <img src="@img" alt="@($"Image of {place.Name}")" />
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="details-content">
            <section class="main-info">

                @if (!string.IsNullOrEmpty(place.Description))
                {
                    <div class="info-section" itemprop="description">
                        <p>@((MarkupString)place.Description.Replace("\n", "<br />"))</p>
                    </div>
                }

                @if (place.Tags?.Any() == true)
                {
                    <div class="tags-container">
                        @foreach (var tag in place.Tags)
                        {
                            <span class="tag" itemprop="keywords">@tag</span>
                        }
                    </div>
                }
            </section>

            <aside class="sidebar-info">

                <div class="info-section">

                    @if (place.Address != null)
                    {
                        <div class="info-item" itemprop="address" itemscope itemtype="http://schema.org/PostalAddress">
                            <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 6v16l7-4 8 4 7-4V2l-7 4-8-4-7 4z"></path>
                                <line x1="8" y1="2" x2="8" y2="18"></line>
                                <line x1="16" y1="6" x2="16" y2="22"></line>
                            </svg>
                            <div class="address-details">
                                @if (!string.IsNullOrEmpty(place.Address.Street))
                                {
                                    <span itemprop="streetAddress">@place.Address.Street</span>
                                    <br />
                                }

                                @{
                                    bool cityWasRendered = false;
                                }

                                @if (!string.IsNullOrEmpty(place.Address.City))
                                {
                                    <span itemprop="addressLocality">@place.Address.City</span>
                                    cityWasRendered = true;
                                }

                                @if (!string.IsNullOrEmpty(place.Address.Province))
                                {
                                    if (cityWasRendered)
                                    {
                                        @:,
                                    }
                                    <span itemprop="addressRegion">@place.Address.Province</span>
                                }

                                @if (cityWasRendered || !string.IsNullOrEmpty(place.Address.Province))
                                {
                                    <br />
                                }

                                @if (!string.IsNullOrEmpty(place.Address.Country))
                                {
                                    <span itemprop="addressCountry">@place.Address.Country</span>
                                }
                            </div>
                        </div>
                    }

                    @if (place.Location != null && place.Location.Coordinates?.Count == 2)
                    {
                        <div class="info-item">
                            <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                <circle cx="12" cy="10" r="3"></circle>
                            </svg>

                            @{
                                var latitude = place.Location.Coordinates[1].ToString(System.Globalization.CultureInfo.InvariantCulture);
                                var longitude = place.Location.Coordinates[0].ToString(System.Globalization.CultureInfo.InvariantCulture);
                                var mapUrl = $"https://www.google.com/maps?q={latitude},{longitude}";
                            }
                            <a href="@mapUrl" target="_blank" rel="noopener noreferrer">
                                Open in Google Maps
                            </a>
                        </div>
                    }

                    @if (place.Phone != null)
                    {
                        @if (!string.IsNullOrEmpty(place.Phone.Callable))
                        {
                            <div class="info-item">
                                <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.63A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>

                                <a href="@($"tel:{place.Phone.Callable}")" itemprop="telephone">@place.Phone.Callable</a>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(place.Phone.Whatsapp))
                        {
                            <div class="info-item">
                                <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>

                                <a href="@($"https://wa.me/{place.Phone.Whatsapp}")" target="_blank" rel="noopener noreferrer">
                                    Chat on WhatsApp (@place.Phone.Whatsapp)
                                </a>
                            </div>
                        }
                    }

                    @if (place.SocialNetwork != null)
                    {
                        @if (!string.IsNullOrEmpty(place.SocialNetwork.Facebook))
                        {
                            <div class="info-item">
                                <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                                <a href="@place.SocialNetwork.Facebook" target="_blank" rel="noopener noreferrer" itemprop="sameAs">Facebook</a>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(place.SocialNetwork.Instagram))
                        {
                            <div class="info-item">
                                <svg class="info-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                                <a href="@place.SocialNetwork.Instagram" target="_blank" rel="noopener noreferrer" itemprop="sameAs">Instagram</a>
                            </div>
                        }
                    }
                </div>

                @if (place.Schedule?.Any() == true)
                {
                    <div class="info-section">
                        <ul class="schedule-list">
                            @foreach (var entry in place.Schedule.Where(s => s.Days.Any() && s.Hours.Any()))
                            {
                                var daysDisplay = string.Join(", ", entry.Days);
                                <li itemprop="openingHoursSpecification" itemscope itemtype="http://schema.org/OpeningHoursSpecification">
                                    <span class="day" itemprop="dayOfWeek">@daysDisplay</span>

                                    @foreach (var hour in entry.Hours)
                                    {
                                        <span class="time">
                                            <meta itemprop="opens" content="@hour.Start" />
                                            <meta itemprop="closes" content="@hour.End" />
                                            @hour.Start - @hour.End
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }

            </aside>
        </div>

    </article>
}
else
{
    <div class="error-message">
        <h2>Place not found</h2>
        <p>Unfortunately, information about this place is not available.</p>
        <a href="/" class="btn-back">← Back to list</a>
    </div>
}


@* ВРЕМЕННО: Добавьте это в любое место (например, в самый низ перед @code), чтобы визуально проверить кэш *@
@* <div style="background: #ffeb3b; color: black; padding: 10px; text-align: center; font-weight: bold;">
    Server Render Time: @DateTime.Now.ToString("HH:mm:ss.fff")
</div> *@


@code {
    [Parameter]
    public string Url { get; set; } = string.Empty;

    private Place? place;
    private bool isLoading = true;
    private string jsonLdBusiness = string.Empty;
    private string jsonLdBreadcrumbs = string.Empty;

    private static readonly JsonSerializerOptions jsonOptions = new JsonSerializerOptions
    {
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull,
    };

    private string FormatProvinceName(string provinceSlug)
    {
        if (string.IsNullOrEmpty(provinceSlug)) return string.Empty;
        var parts = provinceSlug.Split('-');
        var formattedParts = parts.Select(part =>
            char.ToUpper(part[0]) + part.Substring(1)
        );
        var result = string.Join(" ", formattedParts);

        return result switch
        {
            "San Jose" => "San José",
            "Limon" => "Limón",
            _ => result
        };
    }

    private string FormatCategoryName(string categorySlug)
    {
        if (string.IsNullOrEmpty(categorySlug)) return string.Empty;
        return categorySlug switch
        {
            "services" => "Services",
            "to-eat" => "Food & Restaurants",
            "adventures" => "Adventures",
            "shops" => "Shopping",
            _ => char.ToUpper(categorySlug[0]) + categorySlug.Substring(1)
        };
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Url))
        {
            isLoading = false;
            place = null;
            return;
        }

        isLoading = true;
        place = await PlacesService.GetPlaceByUrlAsync(Url);
        isLoading = false;

        if (place != null)
        {
            BuildLocalBusinessJsonLd();
            BuildBreadcrumbsJsonLd();

            // ---  тег для текущей страницы ---
            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext != null)
            {
                var cacheFeature = httpContext.Features.Get<IOutputCacheFeature>();
                if (cacheFeature != null)
                {
                    // Тег в формате "place:url-страницы"
                    cacheFeature.Context.Tags.Add($"place:{Url}");
                }
            }
            // -------------------------------------------------------
        }
        else
        {
            jsonLdBusiness = string.Empty;
            jsonLdBreadcrumbs = string.Empty;
        }

    }

    /// <summary>
    /// Строит JSON-LD для LocalBusiness на основе 'place'
    /// </summary>
    private void BuildLocalBusinessJsonLd()
    {
        if (place == null) return;
        var schema = new LocalBusinessLd
        {
            Type = GetBusinessType(place.Category),
            Name = place.Name
        };
        if (!string.IsNullOrEmpty(place.Description))
        {
            schema.Description = Regex.Replace(place.Description, "<.*?>", "").Replace("\"", "'");
        }

        if (place.ImgLink?.Any() == true)
        {
            schema.Image = place.ImgLink; // Передаем весь список
        }

        if (place.Address != null)
        {
            schema.Address = new PostalAddressLd
            {
                StreetAddress = (place.Address.Street != null && place.Address.Street != "-") ? place.Address.Street : null,
                AddressLocality = string.IsNullOrEmpty(place.Address.City) ? null : place.Address.City,
                AddressRegion = string.IsNullOrEmpty(place.Address.Province) ? null : place.Address.Province,
                AddressCountry = string.IsNullOrEmpty(place.Address.Country) ? null : place.Address.Country
            };
        }

        if (place.Location?.Coordinates?.Count == 2)
        {
            schema.Geo = new GeoCoordinatesLd
            {
                Latitude = place.Location.Coordinates[1].ToString(CultureInfo.InvariantCulture),
                Longitude = place.Location.Coordinates[0].ToString(CultureInfo.InvariantCulture)
            };
        }

        if (place.Phone != null && !string.IsNullOrEmpty(place.Phone.Callable))
        {
            schema.Telephone = place.Phone.Callable;
        }

        if (place.Schedule?.Any() == true)
        {
            var validSchedule = place.Schedule
                .Where(s => s.Days.Any() && s.Hours.Any())
                .ToList();
            if (validSchedule.Any())
            {
                schema.OpeningHoursSpecification = validSchedule.Select(entry => new OpeningHoursSpecificationLd
                {
                    DayOfWeek = entry.Days,
                    Opens = entry.Hours.First().Start,
                    Closes = entry.Hours.First().End
                }).ToList();
            }
        }

        if (place.SocialNetwork != null)
        {
            var socialLinks = new List<string>();
            if (!string.IsNullOrEmpty(place.SocialNetwork.Facebook)) socialLinks.Add(place.SocialNetwork.Facebook);
            if (!string.IsNullOrEmpty(place.SocialNetwork.Instagram)) socialLinks.Add(place.SocialNetwork.Instagram);

            if (socialLinks.Any())
            {
                schema.SameAs = socialLinks;
            }
        }

        jsonLdBusiness = JsonSerializer.Serialize(schema, jsonOptions);
    }

    /// <summary>
    /// Строит JSON-LD для Breadcrumbs на основе 'place'
    /// </summary>
    private void BuildBreadcrumbsJsonLd()
    {
        if (place == null || string.IsNullOrEmpty(place.Category) || place.Address == null || string.IsNullOrEmpty(place.Address.Province))
        {
            jsonLdBreadcrumbs = string.Empty;
            return;
        }

        var schema = new BreadcrumbListLd
        {
            Type = "BreadcrumbList",
            ItemListElement = new List<ListItemLd>
            {
                new ListItemLd
                {
                    Position = 1,
                    Name = "Home",
                    Item = Navigation.BaseUri
                },
                new ListItemLd
                {
                    Position = 2,
                    Name = FormatCategoryName(place.Category),
                    Item = $"{Navigation.BaseUri}?Category={place.Category}"
                },
                new ListItemLd
                {
                    Position = 3,
                    Name = FormatProvinceName(place.Address.Province),
                    Item = $"{Navigation.BaseUri}?Category={place.Category}&Province={place.Address.Province}"
                },
                new ListItemLd
                {
                    Position = 4,
                    Name = place.Name,
                    Item = Navigation.Uri // Или полный URL страницы: $"{Navigation.BaseUri}place/{place.Url}"
                }
            }
        };

        jsonLdBreadcrumbs = JsonSerializer.Serialize(schema, jsonOptions);
    }

    private string GetBusinessType(string category)
    {
        return category switch
        {
            "to-eat" => "Restaurant",
            "services" => "LocalBusiness",
            "adventures" => "TouristAttraction",
            "shops" => "Store",
            _ => "LocalBusiness"
        };
    }
}