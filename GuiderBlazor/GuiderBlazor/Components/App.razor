<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="GuiderBlazor.styles.css" />
    <HeadOutlet />

    <script>
        (function() {
            var cookieTheme = document.cookie.split('; ').find(row => row.startsWith('theme='))?.split('=')[1];
            var localTheme = localStorage.getItem('theme');
            var theme = localTheme || cookieTheme || 'light-theme';
            document.documentElement.className = theme;
            localStorage.setItem('theme', theme);
            document.cookie = `theme=${theme};path=/;max-age=31536000`;
        })();
    </script>
</head>

<body>
    <Routes />

    @* ВАЖНО: Грузим Blazor ТОЛЬКО если это НЕ страница деталей *@
    @if (!IsDetailPage)
    {
        <script src="_framework/blazor.web.js"></script>
        @* app.js нужен для геолокации, которая есть на главной *@
        <script src="js/app.js"></script>
    }

    @* Эти скрипты нужны везде (меню, тема, слайдеры картинок если есть) *@
    <script src="js/theme.js"></script>

    
</body>

</html>

@inject NavigationManager NavManager

@code {
    // Определяем, является ли страница "детальной"
    private bool IsDetailPage
    {
        get
        {
            var uri = new Uri(NavManager.Uri);
            // Если путь начинается с /place/, считаем страницу детальной -> скрипт не грузим
            return uri.AbsolutePath.StartsWith("/place/", StringComparison.OrdinalIgnoreCase);
        }
    }
}