<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="GuiderBlazor.styles.css" />
    <HeadOutlet />

    <script>
        (function() {
            // Эта логика (из theme.js) должна выполниться ДО отрисовки <body>
            // чтобы применить тему из localStorage и избежать "вспышки".
            var theme = localStorage.getItem('theme') || 'light-theme';
            document.documentElement.className = theme;
        })();
    </script>
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>

    <script src="js/theme.js"></script>

    @* <script>loadTheme();</script> *@
</body>

</html>