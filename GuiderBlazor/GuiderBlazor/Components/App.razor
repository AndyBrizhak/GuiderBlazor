<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="GuiderBlazor.styles.css" />
    <HeadOutlet />

    <!-- КРИТИЧЕСКИ ВАЖНО: Применяем тему ДО загрузки Blazor -->
    <script>
        (function() {
            // Проверяем cookie (серверная тема)
            var cookieTheme = document.cookie
                .split('; ')
                .find(row => row.startsWith('theme='))
                ?.split('=')[1];

            // Проверяем localStorage (клиентская тема)
            var localTheme = localStorage.getItem('theme');

            // Приоритет: localStorage > cookie > default
            var theme = localTheme || cookieTheme || 'light-theme';

            // Применяем тему мгновенно
            document.documentElement.className = theme;
            localStorage.setItem('theme', theme);
            document.cookie = `theme=${theme};path=/;max-age=31536000`;
        })();
    </script>
</head>

<body>
    <Routes />

    <!-- Загружаем скрипты в правильном порядке -->
    <script src="_framework/blazor.web.js"></script>
    <script src="js/theme.js"></script>
</body>

</html>