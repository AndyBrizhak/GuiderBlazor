<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="GuiderBlazor.styles.css" />
    <HeadOutlet />

    <!-- Применяем тему ДО загрузки Blazor -->
    <script>
        (function() {
            // Проверяем cookie (серверная тема)
            var cookieTheme = document.cookie
                .split('; ')
                .find(row => row.startsWith('theme='))
                ?.split('=')[1];

            // Проверяем localStorage (клиентская тема)
            var localTheme = localStorage.getItem('theme');

            // Приоритет: localStorage > cookie > default
            var theme = localTheme || cookieTheme || 'light-theme';

            // Применяем тему мгновенно
            document.documentElement.className = theme;
            localStorage.setItem('theme', theme);
            document.cookie = `theme=${theme};path=/;max-age=31536000`;
        })();
    </script>
</head>

<body>
    <Routes />
    @if (!IsStaticPage)
    {
        <script src="_framework/blazor.web.js"></script>
    }
    
    @* <script src="_framework/blazor.web.js"></script> *@
    <script src="js/theme.js"></script>
    <script src="js/location.js"></script>
</body>

</html>

@inject NavigationManager NavManager

@code {
    // Проверяем, находимся ли мы на странице деталей места
    private bool IsStaticPage
    {
        get
        {
            var uri = new Uri(NavManager.Uri);
            // Если путь начинается с /place/, считаем страницу статической
            return uri.AbsolutePath.StartsWith("/place/", StringComparison.OrdinalIgnoreCase);
        }
    }
}